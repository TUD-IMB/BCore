    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/bcore#describes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#describes">
        <rdfs:domain rdf:resource="https://w3id.org/bcore#MediaFile"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brot#Bridge"/>
                    <rdf:Description rdf:about="https://w3id.org/brot#Component"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="de">Mediendatei beschreibt (stellt dar, zeigt, veranschaulicht) eine Brücke</rdfs:comment>
        <rdfs:comment xml:lang="en">media file describes (represents, depicts, illustrates) a bridge</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore/media#containsMedia -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/media#containsMedia">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#MediaFile"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore#MediaFile"/>
        <rdfs:comment xml:lang="de">Mediendatei enthält eine andere Mediendatei</rdfs:comment>
        <rdfs:comment xml:lang="en">media file contains another media file</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/bcore/media#ImageResolutionX -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/media#ImageResolutionX">
        <rdfs:domain rdf:resource="https://w3id.org/bcore/media#Image"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="de">Bildauflösung in X-Richtung</rdfs:comment>
        <rdfs:comment xml:lang="en">image resolution in X-direction</rdfs:comment>
        <rdfs:comment>[pixel]</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/media#ImageResolutionY -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/media#ImageResolutionY">
        <rdfs:domain rdf:resource="https://w3id.org/bcore/media#Image"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="de">Bildauflösung in Y-Richtung</rdfs:comment>
        <rdfs:comment xml:lang="en">image resolution in Y-direction</rdfs:comment>
        <rdfs:comment>[pixel]</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/bcore/media#Document -->

    <owl:Class rdf:about="https://w3id.org/bcore/media#Document">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore#MediaFile"/>
        <rdfs:comment xml:lang="de">Physische oder digitale Darstellung einer Informationseinheit, die zur Kommunikation verwendet werden kann</rdfs:comment>
        <rdfs:comment xml:lang="en">physical or digital representation of a body of information designed with the capacity to communicate</rdfs:comment>
        <rdfs:seeAlso>http://semanticscience.org/resource/SIO_000148</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/media#Image -->

    <owl:Class rdf:about="https://w3id.org/bcore/media#Image">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore#MediaFile"/>
        <rdfs:comment xml:lang="de">Bilddatei</rdfs:comment>
        <rdfs:comment xml:lang="en">image file</rdfs:comment>
        <rdfs:seeAlso>http://semanticscience.org/resource/SIO_000081</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/media#Photo -->

    <owl:Class rdf:about="https://w3id.org/bcore/media#Photo">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/media#Image"/>
        <rdfs:comment xml:lang="de">Foto (entstanden durch auf eine lichtempfindliche Oberfläche fallendes Licht)</rdfs:comment>
        <rdfs:comment xml:lang="en">photograph (created by light falling on light-sensitive surface)</rdfs:comment>
        <rdfs:seeAlso>http://semanticscience.org/resource/SIO_000082</rdfs:seeAlso>
    </owl:Class>
</rdf:RDF>



