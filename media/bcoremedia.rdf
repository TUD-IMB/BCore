<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/bcore/media/"
     xml:base="https://w3id.org/bcore/media/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="https://schema.org/">
    <owl:Ontology rdf:about="https://w3id.org/bcore/media">
        <owl:versionIRI rdf:resource="https://w3id.org/bcore/0.1.0"/>
        <dc:abstract xml:lang="en">The Bridge Core Ontology (BCore) enables the represetation of a bridge structure, its components and material, as well as the infrastructure and media files connected to it and the environment and location of the bridge. BCore is created by the Institute of Concrete Structures (IMB) at the Dresden University of Technology (TUD). This ontology contains the corresponding media extension.</dc:abstract>
        <dc:title xml:lang="en">Bridge Core Ontology for Institute of Concrete Structures, Dresden University of Technology – Media Extension</dc:title>
        <terms:contributor>Jakob Vogt</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-06</terms:created>
        <terms:creator>Johannes Reimer</terms:creator>
        <terms:creator>Morris Florek</terms:creator>
        <terms:creator>Tim Noack</terms:creator>
        <terms:creator>Xiaoli Song</terms:creator>
        <terms:description xml:lang="en">Extension ontology for the representation of bridge-related media. Designed to work in conjunction with the BCore ontology but to also allow for external use.</terms:description>
        <terms:license>https://creativecommons.org/licenses/by/4.0/deed.en</terms:license>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-21</terms:modified>
        <bibo:status>Ontology Specification Draft</bibo:status>
        <vann:preferredNamespacePrefix>bcoremedia</vann:preferredNamespacePrefix>
        <rdfs:label xml:lang="en">Bridge Core Ontology – Media Extension</rdfs:label>
        <owl:priorVersion>https://w3id.org/bcore/0.0.2</owl:priorVersion>
        <owl:versionIRI>https://w3id.org/bcore/0.1.0</owl:versionIRI>
        <owl:versionInfo>0.1.0</owl:versionInfo>
        <schema:codeRepository>https://github.com/TUD-IMB/BCore</schema:codeRepository>
        <foaf:logo>https://raw.githubusercontent.com/TUD-IMB/BCore/main/BCore.svg</foaf:logo>
    </owl:Ontology>
    


