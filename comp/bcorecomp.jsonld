  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Spannweite beginnt an einer Lokalisation (Punkt)"
  }, {
    "@language" : "en",
    "@value" : "span begins at localision (location point)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/bcore/comp#Span"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
