    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/abstract -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/abstract"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/contributor -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/ontology/bibo/status -->

    <owl:AnnotationProperty rdf:about="http://purl.org/ontology/bibo/status"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://www.w3.org/2002/07/owl#versionIRI -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionIRI"/>
    


    <!-- http://xmlns.com/foaf/0.1/logo -->

    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/logo"/>
    


    <!-- https://schema.org/codeRepository -->

    <owl:AnnotationProperty rdf:about="https://schema.org/codeRepository"/>
    


    <!-- https://schema.org/image -->

    <owl:AnnotationProperty rdf:about="https://schema.org/image"/>
    


    <!-- https://schema.org/unitText -->

    <owl:AnnotationProperty rdf:about="https://schema.org/unitText"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/bcore/comp#beginsAtSupport -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/comp#beginsAtSupport">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/comp#Span"/>
        <rdfs:range rdf:resource="https://w3id.org/brcomp#SubStructureComponent"/>
        <owl:propertyDisjointWith rdf:resource="https://w3id.org/bcore/comp#endsAtSupport"/>
        <rdfs:comment xml:lang="de">Spannweite beginnt an einem Bauteil des Brückenunterbaus</rdfs:comment>
        <rdfs:comment xml:lang="en">span begins at a component of the bridge substructure</rdfs:comment>
        <rdfs:label xml:lang="de">beginnt an Stützung</rdfs:label>
        <rdfs:label xml:lang="en">begins at support</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore/comp#endsAtSupport -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/comp#endsAtSupport">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/comp#Span"/>
        <rdfs:range rdf:resource="https://w3id.org/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="de">Spannweite endet an einem Bauteil des Brückenunterbaus</rdfs:comment>
        <rdfs:comment xml:lang="en">span ends at a component of the bridge substructure</rdfs:comment>
        <rdfs:label xml:lang="de">endet an Stützung</rdfs:label>
        <rdfs:label xml:lang="en">ends at support</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore/comp#followsSpan -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/comp#followsSpan">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/comp#Span"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore/comp#Span"/>
        <rdfs:comment xml:lang="de">Spannweite liegt hinter einer anderen Spannweite (wird genutzt, um Teilspannweiten darzustellen, z. B. bei Einzelspannweiten eines Durchlaufträgers oder Hängerabstände einer Schrägkabelbrücke)</rdfs:comment>
        <rdfs:comment xml:lang="en">span is located behind another span (used to represent partial spans, e.g., individual spans of a continuous girder or suspension spans of a cable-stayed bridge)</rdfs:comment>
        <rdfs:label xml:lang="de">folgt auf Brückenfeld</rdfs:label>
        <rdfs:label xml:lang="en">follows span</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore/comp#hasMainSpan -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/comp#hasMainSpan">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore/comp#Span"/>
        <rdfs:comment xml:lang="de">Brücke hat eine Hauptspannweite</rdfs:comment>
        <rdfs:comment xml:lang="en">bridge has main span</rdfs:comment>
        <rdfs:label xml:lang="en">has main span</rdfs:label>
        <rdfs:label xml:lang="de">hat Hauptfeld</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore/comp#hasSpan -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/comp#hasSpan">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/bcore/comp#Arch"/>
                    <rdf:Description rdf:about="https://w3id.org/brcomp#SuperStructureComponent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/bcore/comp#Span"/>
        <rdfs:comment xml:lang="de">Bauteil hat eine Spannweite</rdfs:comment>
        <rdfs:comment xml:lang="en">component has span</rdfs:comment>
        <rdfs:label xml:lang="en">has span</rdfs:label>
        <rdfs:label xml:lang="de">hat Brückenfeld</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore/comp#isSpanOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/comp#isSpanOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/comp#Span"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:comment xml:lang="de">ist Feld von genau einer Brücke</rdfs:comment>
        <rdfs:comment xml:lang="en">the span belongs to just one bridge</rdfs:comment>
        <rdfs:label xml:lang="en">is span of</rdfs:label>
        <rdfs:label xml:lang="de">ist Feld von</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore/comp#runsAlongLineLocalisation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/comp#runsAlongLineLocalisation">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/comp#Span"/>
        <rdfs:range rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#LineLocalisation"/>
        <rdfs:comment xml:lang="de">Spannweite hat den Verlauf einer Linienlokalisierung</rdfs:comment>
        <rdfs:comment xml:lang="en">span follows a line localision</rdfs:comment>
        <rdfs:label xml:lang="en">runs along line localisation</rdfs:label>
        <rdfs:label xml:lang="de">verläuft entlang Linienlokalisierung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/bcore/comp#ArchShape -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/comp#ArchShape">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/comp#Arch"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="de">Form des Bogens</rdfs:comment>
        <rdfs:comment xml:lang="en">shape of the arch</rdfs:comment>
        <rdfs:label xml:lang="de">Bogenform</rdfs:label>
        <rdfs:label xml:lang="en">arch shape</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/comp#GirderShape -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/comp#GirderShape">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/comp#MainGirder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="de">Form des Trägers</rdfs:comment>
        <rdfs:comment xml:lang="en">shape of the girder</rdfs:comment>
        <rdfs:label xml:lang="de">Trägerform</rdfs:label>
        <rdfs:label xml:lang="en">girder shape</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/comp#PierShape -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/comp#PierShape">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brcomp#Pier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="de">Form des Pfeilers</rdfs:comment>
        <rdfs:comment xml:lang="en">shape of the pier</rdfs:comment>
        <rdfs:label xml:lang="de">Pfeilerform</rdfs:label>
        <rdfs:label xml:lang="en">pier shape</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/comp#PylonShape -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/comp#PylonShape">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/comp#Pylon"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="de">Form des Pylons</rdfs:comment>
        <rdfs:comment xml:lang="en">shape of the pylon</rdfs:comment>
        <rdfs:label xml:lang="de">Pylonform</rdfs:label>
        <rdfs:label xml:lang="en">pylon shape</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/comp#SpanLength -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/comp#SpanLength">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/comp#Span"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Länge des Brückenfeldes</rdfs:comment>
        <rdfs:comment xml:lang="en">length of bridge span</rdfs:comment>
        <rdfs:label xml:lang="de">Spannweite</rdfs:label>
        <rdfs:label xml:lang="en">span length</rdfs:label>
        <schema:unitText>m</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://dtc-ontology.cms.ed.tum.de/infraspatialot#LineLocalisation -->

    <owl:Class rdf:about="https://dtc-ontology.cms.ed.tum.de/infraspatialot#LineLocalisation"/>
    


    <!-- https://w3id.org/bcore/comp#Abutment -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#Abutment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="de">Widerlager</rdfs:comment>
        <rdfs:comment xml:lang="en">bridge abutment</rdfs:comment>
        <rdfs:label xml:lang="en">abutment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#Arch -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#Arch">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Brückenbogen</rdfs:comment>
        <rdfs:comment xml:lang="en">bridge arch</rdfs:comment>
        <rdfs:label xml:lang="de">Bogen</rdfs:label>
        <rdfs:label xml:lang="en">arch</rdfs:label>
        <rdfs:seeAlso>https://w3id.org/brcomp#Arch</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#BoxGirder -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#BoxGirder">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/comp#MainGirder"/>
        <rdfs:comment xml:lang="de">Längsträger mit hohlem Querschnitt</rdfs:comment>
        <rdfs:comment xml:lang="en">box girder/ hollow beam</rdfs:comment>
        <rdfs:label xml:lang="de">Hohlkastenträger</rdfs:label>
        <rdfs:label xml:lang="en">box girder</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#Cable -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#Cable">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/comp#TensionComponent"/>
        <rdfs:comment xml:lang="de">Spannkabel</rdfs:comment>
        <rdfs:comment xml:lang="en">suspension cable</rdfs:comment>
        <rdfs:label xml:lang="de">Kabel</rdfs:label>
        <rdfs:label xml:lang="en">cable</rdfs:label>
        <rdfs:seeAlso>https://w3id.org/brcomp#Cable</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#ConcreteTBeam -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#ConcreteTBeam">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/comp#TBeam"/>
        <rdfs:comment xml:lang="de">Längsträger in mit T-förmigem Querschnitt aus Beton</rdfs:comment>
        <rdfs:comment xml:lang="en">T-shaped concrete girder, slab beam</rdfs:comment>
        <rdfs:label xml:lang="de">Plattenbalken</rdfs:label>
        <rdfs:label xml:lang="en">concrete T-beam</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#CrossGirder -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#CrossGirder">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#SuperStructureComponent"/>
        <rdfs:comment xml:lang="en">cross girder/ cross beam, transversal beam</rdfs:comment>
        <rdfs:comment xml:lang="de">transversaler Träger zur Übertragung von Kräften zwischen den Längsträgern oder zum Unterbau</rdfs:comment>
        <rdfs:label xml:lang="de">Querträger</rdfs:label>
        <rdfs:label xml:lang="en">cross girder</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#Deck -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#Deck">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#SuperStructureComponent"/>
        <rdfs:comment xml:lang="de">Platte unter dem Fahrbahnbelag zur Verteilung von Kräften auf Längs- und Querträger</rdfs:comment>
        <rdfs:comment xml:lang="en">bridge deck/slab</rdfs:comment>
        <rdfs:label xml:lang="de">Fahrbahnplatte</rdfs:label>
        <rdfs:label xml:lang="en">deck</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#EquipmentComponent -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#EquipmentComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Brückenbauteil, das kein Haupttragglied ist, aber zentrale funktionale Aufgaben erfüllt</rdfs:comment>
        <rdfs:comment xml:lang="en">component of bridge equipment</rdfs:comment>
        <rdfs:label xml:lang="de">Bauteil der Brückenausstattung</rdfs:label>
        <rdfs:label xml:lang="en">equipment component</rdfs:label>
        <rdfs:seeAlso>https://w3id.org/brcomp/#FinishingComponent</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#IBeam -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#IBeam">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/comp#MainGirder"/>
        <rdfs:comment xml:lang="en">I-shaped girder</rdfs:comment>
        <rdfs:comment xml:lang="de">Längsträger mit I-förmigem Querschnitt</rdfs:comment>
        <rdfs:label xml:lang="de">I-Träger</rdfs:label>
        <rdfs:label xml:lang="en">I-beam</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#MainGirder -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#MainGirder">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#SuperStructureComponent"/>
        <rdfs:comment xml:lang="de">Hauptträger (Längsträger)</rdfs:comment>
        <rdfs:comment xml:lang="en">main, longitudinal girder</rdfs:comment>
        <rdfs:label xml:lang="de">Hauptträger</rdfs:label>
        <rdfs:label xml:lang="en">main girder</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#PierUnit -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#PierUnit">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="de">Pfeilereinheit/-gruppe</rdfs:comment>
        <rdfs:comment xml:lang="en">pier unit/group</rdfs:comment>
        <rdfs:label xml:lang="en">pier unit</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#Pylon -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#Pylon">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Brückenpylon</rdfs:comment>
        <rdfs:comment xml:lang="en">bridge pylon</rdfs:comment>
        <rdfs:label xml:lang="de">Pylon</rdfs:label>
        <rdfs:label xml:lang="en">pylon</rdfs:label>
        <rdfs:seeAlso>https://w3id.org/brcomp#Pylon</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#Rope -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#Rope">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/comp#TensionComponent"/>
        <rdfs:comment xml:lang="de">Seil</rdfs:comment>
        <rdfs:comment xml:lang="de">Tragseil</rdfs:comment>
        <rdfs:comment xml:lang="en">suspension rope</rdfs:comment>
        <rdfs:label xml:lang="en">rope</rdfs:label>
