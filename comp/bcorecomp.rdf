        <rdfs:comment xml:lang="de">Draht</rdfs:comment>
        <rdfs:comment xml:lang="en">wire</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/brcomp#AbutmentBenching -->

    <owl:Class rdf:about="https://w3id.org/brcomp#AbutmentBenching">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#AbutmentComponent"/>
        <rdfs:comment xml:lang="de">Auflagerbank</rdfs:comment>
        <rdfs:comment xml:lang="en">abutment front wall (benching, breast wall, stem)</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/brcomp#AbutmentChamberWall -->

    <owl:Class rdf:about="https://w3id.org/brcomp#AbutmentChamberWall">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#AbutmentComponent"/>
        <rdfs:comment xml:lang="de">Widerlagerwand</rdfs:comment>
        <rdfs:comment xml:lang="en">abutment wall (breast wall, stem)</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/brcomp#AbutmentComponent -->

    <owl:Class rdf:about="https://w3id.org/brcomp#AbutmentComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="de">Bauteil des Widerlagers</rdfs:comment>
        <rdfs:comment xml:lang="en">component of the abutment</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/brcomp#AbutmentFooting -->

    <owl:Class rdf:about="https://w3id.org/brcomp#AbutmentFooting">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#AbutmentComponent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#Foundation"/>
        <rdfs:comment xml:lang="de">Fundament des Widerlagers</rdfs:comment>
        <rdfs:comment xml:lang="en">abutment foundation</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/brcomp#AbutmentWingWall -->

    <owl:Class rdf:about="https://w3id.org/brcomp#AbutmentWingWall">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#AbutmentComponent"/>
        <rdfs:comment xml:lang="de">Flügelwand des Widerlagers</rdfs:comment>
        <rdfs:comment xml:lang="en">abutment wing wall</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/brcomp#Arch -->

    <owl:Class rdf:about="https://w3id.org/brcomp#Arch">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#SubStructureComponent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#SuperStructureComponent"/>
        <rdfs:comment xml:lang="de">Bogen</rdfs:comment>
        <rdfs:comment xml:lang="en">arch</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/brcomp#Bearing -->

    <owl:Class rdf:about="https://w3id.org/brcomp#Bearing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="de">Lager</rdfs:comment>
        <rdfs:comment xml:lang="en">bearing</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/brcomp#Cable -->

    <owl:Class rdf:about="https://w3id.org/brcomp#Cable">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#TensionComponent"/>
        <rdfs:comment xml:lang="de">Kabel</rdfs:comment>
        <rdfs:comment xml:lang="en">cable</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/brcomp#Foundation -->

    <owl:Class rdf:about="https://w3id.org/brcomp#Foundation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="de">Gründung/ Fundament</rdfs:comment>
        <rdfs:comment xml:lang="en">foundation</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/brcomp#Girder -->

    <owl:Class rdf:about="https://w3id.org/brcomp#Girder">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#SuperStructureComponent"/>
        <rdfs:comment xml:lang="de">Brückenträger</rdfs:comment>
        <rdfs:comment xml:lang="en">girder</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/brcomp#GirderComponent -->

    <owl:Class rdf:about="https://w3id.org/brcomp#GirderComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#SuperStructureComponent"/>
        <rdfs:comment>Bauteil des Brückenträgers</rdfs:comment>
        <rdfs:comment xml:lang="en">component of the girder</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/brcomp#GirderCrossGirder -->

    <owl:Class rdf:about="https://w3id.org/brcomp#GirderCrossGirder">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#GirderComponent"/>
        <rdfs:comment xml:lang="de">Querträger</rdfs:comment>
        <rdfs:comment xml:lang="en">cross girder</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/brcomp#GirderDeck -->

    <owl:Class rdf:about="https://w3id.org/brcomp#GirderDeck">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#GirderComponent"/>
        <rdfs:comment xml:lang="de">Fahrbahnplatte</rdfs:comment>
        <rdfs:comment xml:lang="en">bridge deck/slab</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/brcomp#GirderMainGirder -->

    <owl:Class rdf:about="https://w3id.org/brcomp#GirderMainGirder">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#GirderComponent"/>
        <rdfs:comment xml:lang="de">Hauptträger (Längsträger)</rdfs:comment>
        <rdfs:comment xml:lang="en">main (longitudinal) girder</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/brcomp#Pier -->

    <owl:Class rdf:about="https://w3id.org/brcomp#Pier">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="de">Stütze</rdfs:comment>
        <rdfs:comment xml:lang="en">pier</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/brcomp#Pile -->

    <owl:Class rdf:about="https://w3id.org/brcomp#Pile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="de">Bohrpfahl</rdfs:comment>
        <rdfs:comment xml:lang="en">bored/drilled pile</rdfs:comment>
