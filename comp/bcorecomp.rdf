    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/abstract -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/abstract"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/contributor -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/ontology/bibo/status -->

    <owl:AnnotationProperty rdf:about="http://purl.org/ontology/bibo/status"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://www.w3.org/2002/07/owl#versionIRI -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionIRI"/>
    


    <!-- http://xmlns.com/foaf/0.1/logo -->

    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/logo"/>
    


    <!-- https://schema.org/codeRepository -->

    <owl:AnnotationProperty rdf:about="https://schema.org/codeRepository"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/bcore/comp#afterSpan -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/comp#afterSpan">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/comp#Span"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore/comp#Span"/>
        <rdfs:comment xml:lang="de">Spannweite liegt hinter einer anderen Spannweite (wird genutzt, um Teilspannweiten darzustellen, z. B. bei Einzelspannweiten eines Durchlaufträgers oder Hängerabstände einer Schrägkabelbrücke)</rdfs:comment>
        <rdfs:comment xml:lang="en">span is located behind another span (used to represent partial spans, e.g., individual spans of a continuous girder or suspension spans of a cable-stayed bridge)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore/comp#beginsAtLocation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/comp#beginsAtLocation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/comp#Span"/>
        <rdfs:range rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation"/>
        <owl:propertyDisjointWith rdf:resource="https://w3id.org/bcore/comp#endsAtLocation"/>
        <rdfs:comment xml:lang="de">Spannweite beginnt an einer Lokalisation (Punkt)</rdfs:comment>
        <rdfs:comment xml:lang="en">span begins at localision (location point)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore/comp#beginsAtSupport -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/comp#beginsAtSupport">
        <rdfs:domain rdf:resource="https://w3id.org/bcore/comp#Span"/>
        <rdfs:range rdf:resource="https://w3id.org/brcomp#SubStructureComponent"/>
        <owl:propertyDisjointWith rdf:resource="https://w3id.org/bcore/comp#endsAtSupport"/>
        <rdfs:comment xml:lang="de">Spannweite beginnt an einem Bauteil des Brückenunterbaus</rdfs:comment>
        <rdfs:comment xml:lang="en">span begins at a component of the bridge substructure</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore/comp#endsAtLocation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/comp#endsAtLocation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/comp#Span"/>
        <rdfs:range rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation"/>
        <rdfs:comment xml:lang="de">Spannweite endet an einer Lokalisation (Punkt)</rdfs:comment>
        <rdfs:comment xml:lang="en">span ends at localision (location point)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore/comp#endsAtSupport -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/comp#endsAtSupport">
        <rdfs:domain rdf:resource="https://w3id.org/bcore/comp#Span"/>
        <rdfs:range rdf:resource="https://w3id.org/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="de">Spannweite endet an einem Bauteil des Brückenunterbaus</rdfs:comment>
        <rdfs:comment xml:lang="en">span ends at a component of the bridge substructure</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore/comp#hasMainSpan -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/comp#hasMainSpan">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore/comp#Span"/>
        <rdfs:comment xml:lang="de">Brücke hat eine Hauptspannweite</rdfs:comment>
        <rdfs:comment xml:lang="en">bridge has main span</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore/comp#hasSpan -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/comp#hasSpan">
        <rdfs:domain rdf:resource="https://w3id.org/brcomp#SuperStructureComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore/comp#Span"/>
        <rdfs:comment xml:lang="de">Bauteil hat eine Spannweite</rdfs:comment>
        <rdfs:comment xml:lang="en">component has span</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/bcore/comp#ArchShape -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/comp#ArchShape">
        <rdfs:domain rdf:resource="https://w3id.org/brcomp#Arch"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="de">Form des Bogens</rdfs:comment>
        <rdfs:comment xml:lang="en">shape of the arch</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/comp#GirderShape -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/comp#GirderShape">
        <rdfs:domain rdf:resource="https://w3id.org/brcomp#Girder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="de">Form des Trägers</rdfs:comment>
        <rdfs:comment xml:lang="en">shape of the girder</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/comp#PierShape -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/comp#PierShape">
        <rdfs:domain rdf:resource="https://w3id.org/brcomp#Pier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="de">Form des Pfeilers</rdfs:comment>
        <rdfs:comment xml:lang="en">shape of the pier</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/comp#PylonShape -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/comp#PylonShape">
        <rdfs:domain rdf:resource="https://w3id.org/brcomp#Pylon"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="de">Form des Pylons</rdfs:comment>
        <rdfs:comment xml:lang="en">shape of the pylon</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/bcore/comp#Abutment -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#Abutment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="de">Widerlager</rdfs:comment>
        <rdfs:comment xml:lang="en">abutment</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#BoxGirder -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#BoxGirder">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#GirderMainGirder"/>
        <rdfs:comment xml:lang="de">Hohlkastenträger</rdfs:comment>
        <rdfs:comment xml:lang="en">box girder</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#EquipmentComponent -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#EquipmentComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brot#Component"/>
        <owl:disjointWith rdf:resource="https://w3id.org/brcomp#SubStructureComponent"/>
        <owl:disjointWith rdf:resource="https://w3id.org/brcomp#SuperStructureComponent"/>
        <rdfs:comment xml:lang="de">Bauteil der Brückenausstattung</rdfs:comment>
        <rdfs:comment xml:lang="en">component of bridge equipment</rdfs:comment>
        <rdfs:seeAlso>https://w3id.org/brcomp/#FinishingComponent</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#IBeam -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#IBeam">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#GirderMainGirder"/>
        <rdfs:comment xml:lang="de">I-Träger</rdfs:comment>
        <rdfs:comment xml:lang="en">I-beam</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#PierUnit -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#PierUnit">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="de">Pfeilereinheit/-gruppe</rdfs:comment>
        <rdfs:comment xml:lang="en">pier unit/group</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#PlateGirder -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#PlateGirder">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#GirderMainGirder"/>
        <rdfs:comment xml:lang="de">Vollwandträger (z. B. aus Stahl)</rdfs:comment>
        <rdfs:comment xml:lang="en">plate girder (solid-web; e.g., made of steel)</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#Rope -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#Rope">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#TensionComponent"/>
        <rdfs:comment xml:lang="de">Seil</rdfs:comment>
        <rdfs:comment xml:lang="en">rope</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#Slab -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#Slab">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#GirderMainGirder"/>
        <rdfs:comment xml:lang="de">Platte</rdfs:comment>
        <rdfs:comment xml:lang="en">slab</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#Span -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#Span">
        <rdfs:comment xml:lang="de">Spannweite</rdfs:comment>
        <rdfs:comment xml:lang="en">span</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#TBeam -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#TBeam">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#GirderMainGirder"/>
        <rdfs:comment xml:lang="de">Plattenbalken (Beton)</rdfs:comment>
        <rdfs:comment xml:lang="en">T-beam</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#Tendon -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#Tendon">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#TensionComponent"/>
        <rdfs:comment xml:lang="de">Spannglied</rdfs:comment>
        <rdfs:comment xml:lang="en">tendon</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#TrussGirder -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#TrussGirder">
        <rdfs:subClassOf rdf:resource="https://w3id.org/brcomp#GirderMainGirder"/>
        <rdfs:comment xml:lang="de">Fachwerkträger</rdfs:comment>
        <rdfs:comment xml:lang="en">truss girder</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/comp#Wire -->

    <owl:Class rdf:about="https://w3id.org/bcore/comp#Wire">
