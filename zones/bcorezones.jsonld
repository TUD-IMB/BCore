}, {
  "@id" : "https://w3id.org/bcore/zones",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/elements/1.1/abstract" : [ {
    "@language" : "en",
    "@value" : "The Bridge Core Ontology (BCore) enables the represetation of a bridge structure, its components and material, as well as the infrastructure and media files connected to it and the environment and location of the bridge. BCore is created by the Institute of Concrete Structures (IMB) at the Dresden University of Technology (TUD). This ontology contains the corresponding zones extension."
  } ],
  "http://purl.org/dc/elements/1.1/title" : [ {
    "@language" : "en",
    "@value" : "Bridge Core Ontology for Institute of Concrete Structures, Dresden University of Technology – Zones Extension"
  } ],
  "http://purl.org/dc/terms/contributor" : [ {
    "@value" : "Jakob Vogt"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2025-11-06"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Johannes Reimer"
  }, {
    "@value" : "Morris Florek"
  }, {
    "@value" : "Tim Noack"
  }, {
    "@value" : "Xiaoli Song"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Extension ontology for the representation of bridge-related zones. Designed to work in conjunction with the BCore ontology but to also allow for external use."
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@value" : "https://creativecommons.org/licenses/by/4.0/deed.en"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-07-21"
  } ],
  "http://purl.org/ontology/bibo/status" : [ {
    "@value" : "Ontology Specification Draft"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "bcorezones"
  } ],
