    <!-- https://w3id.org/bcore/zones#BuiltUpArea -->

    <owl:Class rdf:about="https://w3id.org/bcore/zones#BuiltUpArea">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Ortschaft/ Fläche, die mit Gebäuden oder Bauwerken bebaut ist oder wird</rdfs:comment>
        <rdfs:comment xml:lang="en">town/ area that is covered with buildings or anthropogene structures</rdfs:comment>
        <rdfs:label xml:lang="de">bebautes Gebiet</rdfs:label>
        <rdfs:label xml:lang="en">built-up area</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/zones#Estate -->

    <owl:Class rdf:about="https://w3id.org/bcore/zones#Estate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Grundstück (Grundbesitz)</rdfs:comment>
        <rdfs:comment xml:lang="en">estate (land ownership, real estate)</rdfs:comment>
        <rdfs:label xml:lang="de">Grundstück</rdfs:label>
        <rdfs:label xml:lang="en">estate</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/zones#Field -->

    <owl:Class rdf:about="https://w3id.org/bcore/zones#Field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/zones#VegetationArea"/>
        <rdfs:comment xml:lang="de">Feld (z. B. Landwirtschaft)</rdfs:comment>
        <rdfs:comment xml:lang="en">field (e.g., agriculture)</rdfs:comment>
        <rdfs:label xml:lang="de">Feld</rdfs:label>
        <rdfs:label xml:lang="en">field</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/zones#Forest -->

    <owl:Class rdf:about="https://w3id.org/bcore/zones#Forest">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/zones#VegetationArea"/>
        <rdfs:comment xml:lang="de">bewaldetes Gebiet</rdfs:comment>
        <rdfs:comment xml:lang="en">forrest/wood</rdfs:comment>
        <rdfs:label xml:lang="de">Wald</rdfs:label>
        <rdfs:label xml:lang="en">forest</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/zones#LandscapeConservationMeasureArea -->

    <owl:Class rdf:about="https://w3id.org/bcore/zones#LandscapeConservationMeasureArea">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Fläche, die einem Landschafts- oder Naturschutz unterliegt</rdfs:comment>
        <rdfs:comment xml:lang="en">area that is protected by landscape or nature protection</rdfs:comment>
        <rdfs:label xml:lang="de">Landschaftsschutzgebiet</rdfs:label>
        <rdfs:label xml:lang="en">landscape conservation measure area</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/zones#Meadow -->

    <owl:Class rdf:about="https://w3id.org/bcore/zones#Meadow">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/zones#VegetationArea"/>
        <rdfs:comment xml:lang="de">Wiese/Aue</rdfs:comment>
        <rdfs:comment xml:lang="en">meadow/ lawn</rdfs:comment>
        <rdfs:label xml:lang="de">Wiese</rdfs:label>
        <rdfs:label xml:lang="en">meadow</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/zones#VegetationArea -->

    <owl:Class rdf:about="https://w3id.org/bcore/zones#VegetationArea">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">bewachsene Fläche</rdfs:comment>
        <rdfs:comment xml:lang="en">planted area</rdfs:comment>
        <rdfs:label xml:lang="de">Vegetationsgebiet</rdfs:label>
        <rdfs:label xml:lang="en">vegetation area</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/zones#WaterBody -->

    <owl:Class rdf:about="https://w3id.org/bcore/zones#WaterBody">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Fläche, die permanent mit Wasser bedeckt ist</rdfs:comment>
        <rdfs:comment xml:lang="en">area that is permanently covered by water</rdfs:comment>
        <rdfs:label xml:lang="de">Gewässer</rdfs:label>
        <rdfs:label xml:lang="en">water body</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bot#Zone -->

    <owl:Class rdf:about="https://w3id.org/bot#Zone"/>
    


