}, {
  "@id" : "https://dtc-ontology.cms.ed.tum.de/infraspatialot#LineLocalisation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Linienlokalisierung (bezeichnet ein Linienobjekt, das durch einen Start- und einen Endpunkt definiert ist und für die lineare Referenzierung gemäß den in ISO 19148 festgelegten Grundsätzen verwendet wird)"
  }, {
    "@language" : "en",
    "@value" : "line localisation (describes a line object which is defined by a start point and an end point and is used for linear referencing according to the principles defined in ISO 19148)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Linienlokalisierung"
  }, {
    "@language" : "en",
    "@value" : "line localisation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation"
  } ]
}, {
  "@id" : "https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Lokalisierung (Standort; beschreibt einen geografischen Ort in Bezug auf ein lineares Referenzelement gemäß den in ISO 19148 festgelegten Grundsätzen)"
  }, {
    "@language" : "en",
    "@value" : "localisation (location; describes a geographic place in relation to a linear reference element according to the principles defined in ISO 19148)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Lokalisierung"
  }, {
    "@language" : "en",
    "@value" : "localisation"
  } ]
