<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/bcore#"
     xml:base="https://w3id.org/bcore"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="https://schema.org/">
    <owl:Ontology rdf:about="https://w3id.org/bcore">
        <dc:abstract xml:lang="en">The Bridge Core Ontology (BCore) enables the representation of a bridge structure, its components and material, as well as the infrastructure and media files connected to it and the environment and location of the bridge. BCore is created by the Institute of Concrete Structures (IMB) at the Dresden University of Technology (TUD).</dc:abstract>
        <dc:title xml:lang="en">Bridge Core Ontology for Institute of Concrete Structures, Dresden University of Technology</dc:title>
        <terms:contributor>Jakob Vogt</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-06</terms:created>
        <terms:creator>Johannes Reimer</terms:creator>
        <terms:creator>Morris Florek</terms:creator>
        <terms:creator>Tim Noack</terms:creator>
        <terms:creator>Xiaoli Song</terms:creator>
        <terms:description xml:lang="en">Core ontology for the representation of bridges.</terms:description>
        <terms:license>https://creativecommons.org/licenses/by/4.0/deed.en</terms:license>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-21</terms:modified>
        <bibo:status>Ontology Specification Draft</bibo:status>
        <vann:preferredNamespacePrefix>bcore</vann:preferredNamespacePrefix>
        <rdfs:label xml:lang="en">Bridge Core Ontology</rdfs:label>
        <owl:versionInfo>0.1.0</owl:versionInfo>
        <schema:codeRepository>https://github.com/TUD-IMB/BCore</schema:codeRepository>
        <foaf:logo>https://raw.githubusercontent.com/TUD-IMB/BCore/main/BCore.svg</foaf:logo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/abstract -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/abstract"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/contributor -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/ontology/bibo/status -->


    <owl:AnnotationProperty rdf:about="http://purl.org/ontology/bibo/status"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://www.w3.org/2002/07/owl#versionIRI -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionIRI"/>
    


    <!-- http://xmlns.com/foaf/0.1/logo -->


    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/logo"/>
    


    <!-- https://schema.org/codeRepository -->


    <owl:AnnotationProperty rdf:about="https://schema.org/codeRepository"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/bcore#bridgesRoute -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#bridgesRoute">
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:comment xml:lang="de">Brücke überquert Trasse</rdfs:comment>
        <rdfs:comment xml:lang="en">bridge bridges route</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#bridgesZone -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#bridgesZone">
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Brücke überquert Zone</rdfs:comment>
        <rdfs:comment xml:lang="en">bridge bridges zone</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#carriesRoute -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#carriesRoute">
        <owl:inverseOf rdf:resource="https://w3id.org/bcore#traversesBridge"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:comment xml:lang="de">Brücke überführt Trasse</rdfs:comment>
        <rdfs:comment xml:lang="en">bridge carries route</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#crossesRoute -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#crossesRoute">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:comment xml:lang="de">Trasse kreuzt Trasse</rdfs:comment>
        <rdfs:comment xml:lang="en">route crosses route</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#crossesZone -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#crossesZone">
        <rdfs:domain rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:range rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Trasse durchquert Zone</rdfs:comment>
        <rdfs:comment xml:lang="en">route crosses zone</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#describes -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#describes">
        <rdfs:domain rdf:resource="https://w3id.org/bcore#MediaFile"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brot#Bridge"/>
                    <rdf:Description rdf:about="https://w3id.org/brot#Component"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="de">Mediendatei beschreibt (stellt dar, zeigt, veranschaulicht) eine Brücke</rdfs:comment>
        <rdfs:comment xml:lang="en">media file describes (represents, depicts, illustrates) a bridge</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#hasPartialStructure -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#hasPartialStructure">
        <owl:inverseOf rdf:resource="https://w3id.org/bcore#isPartialStructureOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:comment xml:lang="de">Brücke besitzt Brückenzug</rdfs:comment>
        <rdfs:comment xml:lang="en">bridge contains partial structure (bridge section)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#includesPoint -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#includesPoint">
        <owl:inverseOf rdf:resource="https://w3id.org/bcore#isPartOfRoute"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:range rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation"/>
        <rdfs:comment xml:lang="de">Trasse enthält Lokalisation (Trassenpunkt)</rdfs:comment>
        <rdfs:comment xml:lang="en">route contains localisation (route point)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#liesWithin -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#liesWithin">
        <owl:inverseOf rdf:resource="https://w3id.org/bot#containsZone"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:range rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Zone liegt in Zone</rdfs:comment>
        <rdfs:comment xml:lang="en">zone lies within zone</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#isLocatedAt -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#isLocatedAt">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:range rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation"/>
        <rdfs:comment xml:lang="de">Zone befindet sich an Lokalisierung (Ort)</rdfs:comment>
        <rdfs:comment xml:lang="en">zone is located at localisation (location)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#isLocatedInZone -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#isLocatedInZone">
        <rdfs:domain rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point"/>
        <rdfs:range rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Lokalisierung (Ort) befindet sich in Zone</rdfs:comment>
        <rdfs:comment xml:lang="en">localisation (location) is located in zone</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#locationAt -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#locationAt">
        <rdfs:domain rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation"/>
        <rdfs:range rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point"/>
        <rdfs:comment xml:lang="de">Punkt der Lokalisierung (Ort)</rdfs:comment>
        <rdfs:comment xml:lang="en">point of the line localisation (location)</rdfs:comment>
        <rdfs:seeAlso>https://dtc-ontology.cms.ed.tum.de/infraspatialot#isisLocatedAt</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#locationEndsAt -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#locationEndsAt">
        <rdfs:domain rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#LineLocalisation"/>
        <rdfs:range rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point"/>
        <owl:propertyDisjointWith rdf:resource="https://w3id.org/bcore#locationStartsAt"/>
        <rdfs:comment xml:lang="de">Endpunkt der Linienlokalisierung</rdfs:comment>
        <rdfs:comment xml:lang="en">end point of the line localisation</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#locationStartsAt -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#locationStartsAt">
        <rdfs:domain rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#LineLocalisation"/>
        <rdfs:range rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point"/>
        <rdfs:comment xml:lang="de">Startpunkt der Linienlokalisierung</rdfs:comment>
        <rdfs:comment xml:lang="en">starting point of the line localisation</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#isMadeOfMaterial -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#isMadeOfMaterial">
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/bmat#BuildingMaterial"/>
        <rdfs:comment xml:lang="de">Bauteil besteht aus Material</rdfs:comment>
        <rdfs:comment xml:lang="en">component consists of material</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#isPartOfComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#isPartOfComponent">
        <owl:inverseOf rdf:resource="https://w3id.org/brot#aggregates"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Bauteil ist Teil von Bauteil</rdfs:comment>
        <rdfs:comment xml:lang="en">component is part of component</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#isPartOfRoute -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#isPartOfRoute">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:comment xml:lang="de">Trassenpunkt ist Teil von Trasse</rdfs:comment>
        <rdfs:comment xml:lang="en">route point is part of a route</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#isPartOfZone -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#isPartOfZone">
        <owl:inverseOf rdf:resource="https://w3id.org/brot#containsComponent"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#SpatialZone"/>
        <rdfs:comment xml:lang="de">Bauteil ist Teil genau einer Zone (z.B. Brücke)</rdfs:comment>
        <rdfs:comment xml:lang="en">component is part of exactly one zone (e.g., bridge)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#isPartialStructureOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#isPartialStructureOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:comment xml:lang="de">Brückenzug ist Teil genau einer Brücke</rdfs:comment>
        <rdfs:comment xml:lang="en">bridge section is part of exactly one bridge</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#traversesBridge -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#traversesBridge">
        <rdfs:domain rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:comment xml:lang="de">Trasse überquert/führt über Brücke</rdfs:comment>
        <rdfs:comment xml:lang="en">route crosses/goes over bridge</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bot#containsZone -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bot#containsZone">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:range rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Zone enthält Zone</rdfs:comment>
        <rdfs:comment xml:lang="en">zone contains zone</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bot#intersectsZone -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bot#intersectsZone">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:range rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Zone schneidet Zone</rdfs:comment>
        <rdfs:comment xml:lang="en">zone intersects zone</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brot#aggregates -->


    <owl:ObjectProperty rdf:about="https://w3id.org/brot#aggregates">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Bauteil besteht aus Bauteil</rdfs:comment>
        <rdfs:comment xml:lang="en">component consists of component</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brot#containsComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/brot#containsComponent">
        <rdfs:domain rdf:resource="https://w3id.org/brot#SpatialZone"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Brücke besteht aus Bauteil</rdfs:comment>
        <rdfs:comment xml:lang="en">bridge consists of component</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/reloc#meetBottom -->


    <owl:ObjectProperty rdf:about="https://w3id.org/reloc#meetBottom">
        <owl:inverseOf rdf:resource="https://w3id.org/reloc#meetTop"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Bauteil liegt direkt unter anderem Bauteil</rdfs:comment>
        <rdfs:comment xml:lang="en">component is located directly below another component</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/reloc#meetFront -->


    <owl:ObjectProperty rdf:about="https://w3id.org/reloc#meetFront">
        <owl:inverseOf rdf:resource="https://w3id.org/reloc#meetRear"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Bauteil liegt direkt vor anderem Bauteil</rdfs:comment>
        <rdfs:comment xml:lang="en">component is located directly in front of another component</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/reloc#meetLeft -->


    <owl:ObjectProperty rdf:about="https://w3id.org/reloc#meetLeft">
        <owl:inverseOf rdf:resource="https://w3id.org/reloc#meetRight"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Bauteil liegt links angrenzend zu anderem Bauteil</rdfs:comment>
        <rdfs:comment xml:lang="en">component is located directly to the left of another component</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/reloc#meetRear -->


    <owl:ObjectProperty rdf:about="https://w3id.org/reloc#meetRear">
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Bauteil liegt direkt hinter anderem Bauteil</rdfs:comment>
        <rdfs:comment xml:lang="en">component is located directly behind another component</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/reloc#meetRight -->


    <owl:ObjectProperty rdf:about="https://w3id.org/reloc#meetRight">
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Bauteil liegt rechts angrenzend zu anderem Bauteil</rdfs:comment>
        <rdfs:comment xml:lang="en">component is located directly to the right of another component</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/reloc#meetTop -->


    <owl:ObjectProperty rdf:about="https://w3id.org/reloc#meetTop">
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Bauteil liegt direkt über anderem Bauteil</rdfs:comment>
        <rdfs:comment xml:lang="en">component is located directly above another component</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/bcore#Altitude -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#Altitude">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Höhe ü. NN (bezogen auf das lokal gültige amtliche Höhensystem)</rdfs:comment>
        <rdfs:comment xml:lang="en">elevation above sea level (according to the locally applicable official elevation system)</rdfs:comment>
        <rdfs:comment>[m]</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore#BridgeConstructionEndDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#BridgeConstructionEndDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="de">Enddatum des Baus der Brücke (Fertigstellung)</rdfs:comment>
        <rdfs:comment xml:lang="en">end date of the bridge&apos;s construction (completion)</rdfs:comment>
        <rdfs:comment>[ISO Date Format]</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore#BridgeConstructionStart -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#BridgeConstructionStart">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
