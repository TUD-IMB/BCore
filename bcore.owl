        <rdfs:comment xml:lang="de">Infrastrukturtrasse</rdfs:comment>
        <rdfs:comment xml:lang="en">infrastructure route</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore#MediaFile -->


    <owl:Class rdf:about="https://w3id.org/bcore#MediaFile">
