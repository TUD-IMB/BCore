     -->


    


    <!-- https://dtc-ontology.cms.ed.tum.de/infraspatialot#LineLocalisation -->


    <owl:Class rdf:about="https://dtc-ontology.cms.ed.tum.de/infraspatialot#LineLocalisation">
        <rdfs:subClassOf rdf:resource="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation"/>
        <rdfs:comment xml:lang="de">Linienlokalisierung (bezeichnet ein Linienobjekt, das durch einen Start- und einen Endpunkt definiert ist und für die lineare Referenzierung gemäß den in ISO 19148 festgelegten Grundsätzen verwendet wird)</rdfs:comment>
        <rdfs:comment xml:lang="en">line localisation (describes a line object which is defined by a start point and an end point and is used for linear referencing according to the principles defined in ISO 19148)</rdfs:comment>
    </owl:Class>
    


    <!-- https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation -->


    <owl:Class rdf:about="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation">
        <rdfs:comment xml:lang="de">Lokalisierung (Standort; beschreibt einen geografischen Ort in Bezug auf ein lineares Referenzelement gemäß den in ISO 19148 festgelegten Grundsätzen)</rdfs:comment>
        <rdfs:comment xml:lang="en">localisation (location; describes a geographic place in relation to a linear reference element according to the principles defined in ISO 19148)</rdfs:comment>
    </owl:Class>
    


    <!-- https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point -->


    <owl:Class rdf:about="https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point">
        <rdfs:comment xml:lang="de">Punkt im dreidimensionalen Raum</rdfs:comment>
        <rdfs:comment xml:lang="en">point in three-dimensional space</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore#City -->


    <owl:Class rdf:about="https://w3id.org/bcore#City">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Stadt (kann auch für andere Ortschaften verwendet werden)</rdfs:comment>
        <rdfs:comment xml:lang="en">city (can also be used for towns and thelike)</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore#Country -->


    <owl:Class rdf:about="https://w3id.org/bcore#Country">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Land (Nationalstaat)</rdfs:comment>
        <rdfs:comment xml:lang="en">country (nation-state)</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore#InfrastructureRoute -->


