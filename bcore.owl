        <rdfs:comment xml:lang="en">media file</rdfs:comment>
        <rdfs:seeAlso>http://semanticscience.org/resource/SIO_001194</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://w3id.org/bcore#Region -->


