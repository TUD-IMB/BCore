@prefix : <https://w3id.org/BCore#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/BCore#> .

<https://w3id.org/BCore> rdf:type owl:Ontology ;
                          <http://purl.org/dc/elements/1.1/title> "Bridge Core Ontology" ;
                          <http://purl.org/dc/terms/contributor> "Jakob Vogt" ,
                                                                 "Johannes Reimer" ,
                                                                 "Morris Florek" ,
                                                                 "Xiaoli Song" ;
                          <http://purl.org/dc/terms/created> "2025-11-06T11:00:00"^^xsd:dateTime ;
                          <http://purl.org/dc/terms/creator> "Tim Noack" ;
                          <http://purl.org/dc/terms/hasVersion> "0.0.1" ;
                          rdfs:label "Technische Unversität Dresden, Institute of Concrete Structures' Bridge Core Ontology" ;
                          owl:versionInfo 2.0 .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/hasVersion
<http://purl.org/dc/terms/hasVersion> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/BCore/bridgesRoute
<https://w3id.org/BCore/bridgesRoute> rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf owl:topObjectProperty ;
                                      rdfs:domain <https://w3id.org/brot#Bridge> ;
                                      rdfs:range <https://w3id.org/BCore/InfrastructureRoute> ;
                                      rdfs:comment "Brücke überquert Trasse"@de .


###  https://w3id.org/BCore/bridgesZone
<https://w3id.org/BCore/bridgesZone> rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf owl:topObjectProperty ;
                                     rdfs:domain <https://w3id.org/brot#Bridge> ;
                                     rdfs:range <https://w3id.org/bot#Zone> ;
                                     rdfs:comment "Brücke überquert Zone"@de .


###  https://w3id.org/BCore/carriesRoute
<https://w3id.org/BCore/carriesRoute> rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf owl:topObjectProperty ;
                                      owl:inverseOf <https://w3id.org/BCore/traversesBridge> ;
                                      rdfs:domain <https://w3id.org/brot#Bridge> ;
                                      rdfs:range <https://w3id.org/BCore/InfrastructureRoute> ;
                                      rdfs:comment "Brücke folgt Trasse"@de .


###  https://w3id.org/BCore/compositeOf
<https://w3id.org/BCore/compositeOf> rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf owl:topObjectProperty ;
                                     rdfs:domain <https://w3id.org/BCore/CompositeMaterial> ;
                                     rdfs:range <https://w3id.org/bmat#BuildingMaterial> ;
                                     rdfs:comment "Verbundmaterial ist Verbund aus anderem Material"@de .


###  https://w3id.org/BCore/crossesRoute
<https://w3id.org/BCore/crossesRoute> rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf owl:topObjectProperty ;
                                      rdf:type owl:SymmetricProperty ;
                                      rdfs:domain <https://w3id.org/BCore/InfrastructureRoute> ;
                                      rdfs:range <https://w3id.org/BCore/InfrastructureRoute> ;
                                      rdfs:comment "Trasse kreuzt Trasse"@de .


###  https://w3id.org/BCore/crossesZone
<https://w3id.org/BCore/crossesZone> rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf owl:topObjectProperty ;
                                     rdfs:domain <https://w3id.org/BCore/InfrastructureRoute> ;
                                     rdfs:range <https://w3id.org/bot#Zone> ;
                                     rdfs:comment "Trasse durchquert Zone"@de .


###  https://w3id.org/BCore/describes
<https://w3id.org/BCore/describes> rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf owl:topObjectProperty ;
                                   rdfs:domain <https://w3id.org/BCore/MediaFile> ;
                                   rdfs:range <https://w3id.org/brot#Bridge> ;
                                   rdfs:comment "Medium stellt Brücke dar"@de .


###  https://w3id.org/BCore/hasPartialStructure
<https://w3id.org/BCore/hasPartialStructure> rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf owl:topObjectProperty ;
                                             owl:inverseOf <https://w3id.org/BCore/partialStructureOf> ;
                                             rdfs:domain <https://w3id.org/brot#Bridge> ;
                                             rdfs:range <https://w3id.org/brot#Bridge> ;
                                             rdfs:comment "Brücke besitzt Brückenzug"@de .


###  https://w3id.org/BCore/includesPoint
<https://w3id.org/BCore/includesPoint> rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf owl:topObjectProperty ;
                                       owl:inverseOf <https://w3id.org/BCore/partOfRoute> ;
                                       rdfs:domain <https://w3id.org/BCore/InfrastructureRoute> ;
                                       rdfs:range <https://w3id.org/BCore/RoutePoint> ;
                                       rdfs:comment "Trasse enthält Trassenpunkt"@de .


###  https://w3id.org/BCore/liesWithin
<https://w3id.org/BCore/liesWithin> rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf owl:topObjectProperty ;
                                    owl:inverseOf <https://w3id.org/bot#containsZone> ;
                                    rdf:type owl:TransitiveProperty ;
                                    rdfs:domain <https://w3id.org/bot#Zone> ;
                                    rdfs:range <https://w3id.org/bot#Zone> ;
                                    rdfs:comment "Zone liegt in Zone"@de .


###  https://w3id.org/BCore/locatedAt
<https://w3id.org/BCore/locatedAt> rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf owl:topObjectProperty ;
                                   rdf:type owl:FunctionalProperty ;
                                   rdfs:domain <https://w3id.org/bot#Zone> ;
                                   rdfs:range <https://w3id.org/BCore/LocationPoint> ;
                                   rdfs:comment "Zone befindet sich an Ort"@de .


###  https://w3id.org/BCore/locatedInZone
<https://w3id.org/BCore/locatedInZone> rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf owl:topObjectProperty ;
                                       rdfs:domain <https://w3id.org/BCore/LocationPoint> ;
                                       rdfs:range <https://w3id.org/bot#Zone> ;
                                       rdfs:comment "Örtlicher Punkt befindet sich in Zone"@de .


###  https://w3id.org/BCore/madeOfMaterial
<https://w3id.org/BCore/madeOfMaterial> rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf owl:topObjectProperty ;
                                        rdfs:domain <https://w3id.org/brot#Component> ;
                                        rdfs:range <https://w3id.org/bmat#BuildingMaterial> ;
                                        rdfs:comment "Bauteil besteht aus Material"@de .


###  https://w3id.org/BCore/partOfComponent
<https://w3id.org/BCore/partOfComponent> rdf:type owl:ObjectProperty ;
                                         rdfs:subPropertyOf owl:topObjectProperty ;
                                         owl:inverseOf <https://w3id.org/brot#aggregates> ;
                                         rdf:type owl:TransitiveProperty ;
                                         rdfs:domain <https://w3id.org/brot#Component> ;
                                         rdfs:range <https://w3id.org/brot#Component> ;
                                         rdfs:comment "Bauteil ist Teil von Bauteil"@de .


###  https://w3id.org/BCore/partOfRoute
<https://w3id.org/BCore/partOfRoute> rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf owl:topObjectProperty ;
                                     rdf:type owl:FunctionalProperty ;
                                     rdfs:domain <https://w3id.org/BCore/RoutePoint> ;
                                     rdfs:range <https://w3id.org/BCore/InfrastructureRoute> ;
                                     rdfs:comment "Trassenpunkt ist Teil von Trasse"@de .


###  https://w3id.org/BCore/partOfZone
<https://w3id.org/BCore/partOfZone> rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf owl:topObjectProperty ;
                                    owl:inverseOf <https://w3id.org/brot#containsComponent> ;
                                    rdf:type owl:FunctionalProperty ;
                                    rdfs:domain <https://w3id.org/brot#Component> ;
                                    rdfs:range <https://w3id.org/brot#SpatialZone> ;
                                    rdfs:comment "Bauteil ist Teil genau einer Brücke"@de .


###  https://w3id.org/BCore/partialStructureOf
<https://w3id.org/BCore/partialStructureOf> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf owl:topObjectProperty ;
                                            rdf:type owl:FunctionalProperty ;
                                            rdfs:domain <https://w3id.org/brot#Bridge> ;
                                            rdfs:range <https://w3id.org/brot#Bridge> ;
                                            rdfs:comment "Brückenzug ist Teil genau einer Brücke"@de .


###  https://w3id.org/BCore/traversesBridge
<https://w3id.org/BCore/traversesBridge> rdf:type owl:ObjectProperty ;
                                         rdfs:subPropertyOf owl:topObjectProperty ;
                                         rdfs:domain <https://w3id.org/BCore/InfrastructureRoute> ;
                                         rdfs:range <https://w3id.org/brot#Bridge> ;
                                         rdfs:comment "Trasse überquert Brücke"@de .


###  https://w3id.org/bot#containsZone
<https://w3id.org/bot#containsZone> rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf owl:topObjectProperty ;
                                    rdf:type owl:TransitiveProperty ;
                                    rdfs:domain <https://w3id.org/bot#Zone> ;
                                    rdfs:range <https://w3id.org/bot#Zone> ;
                                    rdfs:comment "Zone enthält Zone"@de .


###  https://w3id.org/bot#intersectsZone
<https://w3id.org/bot#intersectsZone> rdf:type owl:ObjectProperty ,
                                               owl:SymmetricProperty ;
                                      rdfs:domain <https://w3id.org/bot#Zone> ;
                                      rdfs:range <https://w3id.org/bot#Zone> ;
                                      rdfs:comment "Zone schneidet Zone"@de .


###  https://w3id.org/brot#aggregates
<https://w3id.org/brot#aggregates> rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf owl:topObjectProperty ;
                                   rdf:type owl:TransitiveProperty ;
                                   rdfs:domain <https://w3id.org/brot#Component> ;
                                   rdfs:range <https://w3id.org/brot#Component> ;
                                   rdfs:comment "Bauteil besteht aus Bauteil"@de .


###  https://w3id.org/brot#containsComponent
<https://w3id.org/brot#containsComponent> rdf:type owl:ObjectProperty ;
                                          rdfs:subPropertyOf owl:topObjectProperty ;
                                          rdfs:domain <https://w3id.org/brot#SpatialZone> ;
                                          rdfs:range <https://w3id.org/brot#Component> ;
                                          rdfs:comment "Brücke besteht aus Bauteil"@de .


###  https://w3id.org/reloc#meetBottom
<https://w3id.org/reloc#meetBottom> rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf owl:topObjectProperty ;
                                    owl:inverseOf <https://w3id.org/reloc#meetTop> ;
                                    rdfs:domain <https://w3id.org/brot#Component> ;
                                    rdfs:range <https://w3id.org/brot#Component> ;
                                    rdfs:comment "Bauteil liegt direkt unter anderem Bauteil"@de .


###  https://w3id.org/reloc#meetLeft
<https://w3id.org/reloc#meetLeft> rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf owl:topObjectProperty ;
                                  owl:inverseOf <https://w3id.org/reloc#meetRight> ;
                                  rdfs:domain <https://w3id.org/brot#Component> ;
                                  rdfs:range <https://w3id.org/brot#Component> ;
                                  rdfs:comment "Bauteil liegt links angrenzend zu anderem Bauteil"@de .


###  https://w3id.org/reloc#meetRight
<https://w3id.org/reloc#meetRight> rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf owl:topObjectProperty ;
                                   rdfs:domain <https://w3id.org/brot#Component> ;
                                   rdfs:range <https://w3id.org/brot#Component> ;
                                   rdfs:comment "Bauteil liegt rechts angrenzend zu anderem Bauteil"@de .


###  https://w3id.org/reloc#meetTop
<https://w3id.org/reloc#meetTop> rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf owl:topObjectProperty ;
                                 rdfs:domain <https://w3id.org/brot#Component> ;
                                 rdfs:range <https://w3id.org/brot#Component> ;
                                 rdfs:comment "Bauteil liegt direkt über anderem Bauteil"@de .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/BCore/Altitude
<https://w3id.org/BCore/Altitude> rdf:type owl:DatatypeProperty ,
                                           owl:FunctionalProperty ;
                                  rdfs:domain <https://w3id.org/BCore/LocationPoint> ;
                                  rdfs:range xsd:decimal ;
                                  rdfs:comment "Höhe über NN"@de ,
                                               "[m]" .


###  https://w3id.org/BCore/ArchShape
<https://w3id.org/BCore/ArchShape> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://w3id.org/brcomp#Arch> ;
                                   rdfs:range xsd:string ;
                                   rdfs:comment "Form des Bogens" .


###  https://w3id.org/BCore/BridgeConstructionEndDate
<https://w3id.org/BCore/BridgeConstructionEndDate> rdf:type owl:DatatypeProperty ,
                                                            owl:FunctionalProperty ;
                                                   rdfs:domain <https://w3id.org/brot#Bridge> ;
                                                   rdfs:range xsd:string ;
                                                   rdfs:comment "Datum der Brückenfertigstellung"@de ,
                                                                "[ISO Date Format]" .


###  https://w3id.org/BCore/BridgeID
<https://w3id.org/BCore/BridgeID> rdf:type owl:DatatypeProperty ,
                                           owl:FunctionalProperty ;
                                  rdfs:domain <https://w3id.org/brot#Bridge> ;
                                  rdfs:range xsd:int ;
                                  rdfs:comment "Identifikationsnummer der Brücke"@de .


###  https://w3id.org/BCore/BridgeName
<https://w3id.org/BCore/BridgeName> rdf:type owl:DatatypeProperty ,
                                             owl:FunctionalProperty ;
                                    rdfs:domain <https://w3id.org/brot#Bridge> ;
                                    rdfs:range xsd:string ;
                                    rdfs:comment "Name der Brücke"@de .


###  https://w3id.org/BCore/BridgeStatus
<https://w3id.org/BCore/BridgeStatus> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <https://w3id.org/brot#Bridge> ;
                                      rdfs:range xsd:string ;
                                      rdfs:comment "Status der Brücke"@de .


###  https://w3id.org/BCore/ComponentVolume
<https://w3id.org/BCore/ComponentVolume> rdf:type owl:DatatypeProperty ;
                                         rdfs:subPropertyOf owl:topDataProperty ;
                                         rdf:type owl:FunctionalProperty ;
                                         rdfs:domain <https://w3id.org/brot#Component> ;
                                         rdfs:range xsd:decimal ;
                                         rdfs:comment "Volumen"@de ,
                                                      "[m³]" .


###  https://w3id.org/BCore/Density
<https://w3id.org/BCore/Density> rdf:type owl:DatatypeProperty ;
                                 rdfs:subPropertyOf owl:topDataProperty ;
                                 rdf:type owl:FunctionalProperty ;
                                 rdfs:domain <https://w3id.org/bmat#BuildingMaterial> ;
                                 rdfs:range xsd:decimal ;
                                 rdfs:comment "Dichte"@de ,
                                              "[kg/m³]" .


###  https://w3id.org/BCore/Ductility
<https://w3id.org/BCore/Ductility> rdf:type owl:DatatypeProperty ,
                                            owl:FunctionalProperty ;
                                   rdfs:domain <https://w3id.org/BCore/Steel> ;
                                   rdfs:range xsd:string ;
                                   rdfs:comment "Duktilität"@de .


###  https://w3id.org/BCore/Ec
