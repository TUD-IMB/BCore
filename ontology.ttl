                                     owl:FunctionalProperty ;
                            rdfs:domain <https://w3id.org/bmat#Concrete> ;
                            rdfs:range xsd:decimal ;
                            rdfs:comment "Elastizitätsmodul des Betons"@de ,
                                         "[N/m²]" .


