@prefix : <https://w3id.org/BCore/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix terms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/BCore/> .

<https://w3id.org/BCore> rdf:type owl:Ontology ;
                          dc:title "Bridge Core Ontology" ;
                          terms:contributor "Jakob Vogt" ,
                                            "Johannes Reimer" ,
                                            "Morris Florek" ,
                                            "Xiaoli Song" ;
                          terms:created "2025-11-06T11:00:00"^^xsd:dateTime ;
                          terms:creator "Tim Noack" ;
                          terms:hasVersion "0.0.1" ;
                          rdfs:label "Technische Unversität Dresden, Institute of Concrete Structures' Bridge Core Ontology" ;
                          owl:versionInfo 2.0 .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
terms:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
terms:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
terms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/hasVersion
terms:hasVersion rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/BCore#bridgesRoute
:bridgesRoute rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain <https://w3id.org/brot#Bridge> ;
              rdfs:range :InfrastructureRoute ;
              rdfs:comment "Brücke überquert Trasse"@de .


###  https://w3id.org/BCore#bridgesZone
:bridgesZone rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain <https://w3id.org/brot#Bridge> ;
             rdfs:range <https://w3id.org/bot#Zone> ;
             rdfs:comment "Brücke überquert Zone"@de .


###  https://w3id.org/BCore#carriesRoute
:carriesRoute rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              owl:inverseOf :traversesBridge ;
              rdfs:domain <https://w3id.org/brot#Bridge> ;
              rdfs:range :InfrastructureRoute ;
              rdfs:comment "Brücke folgt Trasse"@de .


###  https://w3id.org/BCore#compositeOf
:compositeOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain :CompositeMaterial ;
             rdfs:range <https://w3id.org/bmat#BuildingMaterial> ;
             rdfs:comment "Verbundmaterial ist Verbund aus anderem Material"@de .


###  https://w3id.org/BCore#crossesRoute
:crossesRoute rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdf:type owl:SymmetricProperty ;
              rdfs:domain :InfrastructureRoute ;
              rdfs:range :InfrastructureRoute ;
              rdfs:comment "Trasse kreuzt Trasse"@de .


###  https://w3id.org/BCore#crossesZone
:crossesZone rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain :InfrastructureRoute ;
             rdfs:range <https://w3id.org/bot#Zone> ;
             rdfs:comment "Trasse durchquert Zone"@de .


###  https://w3id.org/BCore#describes
:describes rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain :MediaFile ;
           rdfs:range <https://w3id.org/brot#Bridge> ;
           rdfs:comment "Medium stellt Brücke dar"@de .


###  https://w3id.org/BCore#hasPartialStructure
:hasPartialStructure rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf owl:topObjectProperty ;
                     owl:inverseOf :partialStructureOf ;
                     rdfs:domain <https://w3id.org/brot#Bridge> ;
                     rdfs:range <https://w3id.org/brot#Bridge> ;
                     rdfs:comment "Brücke besitzt Brückenzug"@de .


###  https://w3id.org/BCore#includesPoint
:includesPoint rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               owl:inverseOf :partOfRoute ;
               rdfs:domain :InfrastructureRoute ;
               rdfs:range :RoutePoint ;
               rdfs:comment "Trasse enthält Trassenpunkt"@de .


###  https://w3id.org/BCore#liesWithin
:liesWithin rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            owl:inverseOf <https://w3id.org/bot#containsZone> ;
            rdf:type owl:TransitiveProperty ;
            rdfs:domain <https://w3id.org/bot#Zone> ;
            rdfs:range <https://w3id.org/bot#Zone> ;
            rdfs:comment "Zone liegt in Zone"@de .


###  https://w3id.org/BCore#locatedAt
:locatedAt rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdf:type owl:FunctionalProperty ;
           rdfs:domain <https://w3id.org/bot#Zone> ;
           rdfs:range :LocationPoint ;
           rdfs:comment "Zone befindet sich an Ort"@de .


###  https://w3id.org/BCore#locatedInZone
:locatedInZone rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :LocationPoint ;
               rdfs:range <https://w3id.org/bot#Zone> ;
               rdfs:comment "Örtlicher Punkt befindet sich in Zone"@de .


###  https://w3id.org/BCore#madeOfMaterial
:madeOfMaterial rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:domain <https://w3id.org/brot#Component> ;
                rdfs:range <https://w3id.org/bmat#BuildingMaterial> ;
                rdfs:comment "Bauteil besteht aus Material"@de .


###  https://w3id.org/BCore#partOfComponent
:partOfComponent rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 owl:inverseOf <https://w3id.org/brot#aggregates> ;
                 rdf:type owl:TransitiveProperty ;
                 rdfs:domain <https://w3id.org/brot#Component> ;
                 rdfs:range <https://w3id.org/brot#Component> ;
                 rdfs:comment "Bauteil ist Teil von Bauteil"@de .


###  https://w3id.org/BCore#partOfRoute
:partOfRoute rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdf:type owl:FunctionalProperty ;
             rdfs:domain :RoutePoint ;
             rdfs:range :InfrastructureRoute ;
             rdfs:comment "Trassenpunkt ist Teil von Trasse"@de .


###  https://w3id.org/BCore#partOfZone
:partOfZone rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            owl:inverseOf <https://w3id.org/brot#containsComponent> ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brot#Component> ;
            rdfs:range <https://w3id.org/brot#SpatialZone> ;
            rdfs:comment "Bauteil ist Teil genau einer Brücke"@de .


###  https://w3id.org/BCore#partialStructureOf
:partialStructureOf rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdf:type owl:FunctionalProperty ;
                    rdfs:domain <https://w3id.org/brot#Bridge> ;
                    rdfs:range <https://w3id.org/brot#Bridge> ;
                    rdfs:comment "Brückenzug ist Teil genau einer Brücke"@de .


###  https://w3id.org/BCore#traversesBridge
:traversesBridge rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdfs:domain :InfrastructureRoute ;
                 rdfs:range <https://w3id.org/brot#Bridge> ;
                 rdfs:comment "Trasse überquert Brücke"@de .


###  https://w3id.org/bot#containsZone
<https://w3id.org/bot#containsZone> rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf owl:topObjectProperty ;
                                    rdf:type owl:TransitiveProperty ;
                                    rdfs:domain <https://w3id.org/bot#Zone> ;
                                    rdfs:range <https://w3id.org/bot#Zone> ;
                                    rdfs:comment "Zone enthält Zone"@de .


###  https://w3id.org/bot#intersectsZone
<https://w3id.org/bot#intersectsZone> rdf:type owl:ObjectProperty ,
                                               owl:SymmetricProperty ;
                                      rdfs:domain <https://w3id.org/bot#Zone> ;
                                      rdfs:range <https://w3id.org/bot#Zone> ;
                                      rdfs:comment "Zone schneidet Zone"@de .


###  https://w3id.org/brot#aggregates
<https://w3id.org/brot#aggregates> rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf owl:topObjectProperty ;
                                   rdf:type owl:TransitiveProperty ;
                                   rdfs:domain <https://w3id.org/brot#Component> ;
                                   rdfs:range <https://w3id.org/brot#Component> ;
                                   rdfs:comment "Bauteil besteht aus Bauteil"@de .


###  https://w3id.org/brot#containsComponent
<https://w3id.org/brot#containsComponent> rdf:type owl:ObjectProperty ;
                                          rdfs:subPropertyOf owl:topObjectProperty ;
                                          rdfs:domain <https://w3id.org/brot#SpatialZone> ;
                                          rdfs:range <https://w3id.org/brot#Component> ;
                                          rdfs:comment "Brücke besteht aus Bauteil"@de .


###  https://w3id.org/reloc#meetBottom
<https://w3id.org/reloc#meetBottom> rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf owl:topObjectProperty ;
                                    owl:inverseOf <https://w3id.org/reloc#meetTop> ;
                                    rdfs:domain <https://w3id.org/brot#Component> ;
                                    rdfs:range <https://w3id.org/brot#Component> ;
                                    rdfs:comment "Bauteil liegt direkt unter anderem Bauteil"@de .


###  https://w3id.org/reloc#meetLeft
<https://w3id.org/reloc#meetLeft> rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf owl:topObjectProperty ;
                                  owl:inverseOf <https://w3id.org/reloc#meetRight> ;
                                  rdfs:domain <https://w3id.org/brot#Component> ;
                                  rdfs:range <https://w3id.org/brot#Component> ;
                                  rdfs:comment "Bauteil liegt links angrenzend zu anderem Bauteil"@de .


###  https://w3id.org/reloc#meetRight
<https://w3id.org/reloc#meetRight> rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf owl:topObjectProperty ;
                                   rdfs:domain <https://w3id.org/brot#Component> ;
                                   rdfs:range <https://w3id.org/brot#Component> ;
                                   rdfs:comment "Bauteil liegt rechts angrenzend zu anderem Bauteil"@de .


###  https://w3id.org/reloc#meetTop
<https://w3id.org/reloc#meetTop> rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf owl:topObjectProperty ;
                                 rdfs:domain <https://w3id.org/brot#Component> ;
                                 rdfs:range <https://w3id.org/brot#Component> ;
                                 rdfs:comment "Bauteil liegt direkt über anderem Bauteil"@de .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/BCore#Altitude
:Altitude rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :LocationPoint ;
          rdfs:range xsd:decimal ;
          rdfs:comment "Höhe über NN"@de ,
                       "[m]" .


###  https://w3id.org/BCore#ArchShape
:ArchShape rdf:type owl:DatatypeProperty ;
           rdfs:domain <https://w3id.org/brcomp#Arch> ;
           rdfs:range xsd:string ;
           rdfs:comment "Form des Bogens" .


###  https://w3id.org/BCore#BridgeConstructionEndDate
:BridgeConstructionEndDate rdf:type owl:DatatypeProperty ,
                                    owl:FunctionalProperty ;
                           rdfs:domain <https://w3id.org/brot#Bridge> ;
                           rdfs:range xsd:string ;
                           rdfs:comment "Datum der Brückenfertigstellung"@de ,
                                        "[ISO Date Format]" .


###  https://w3id.org/BCore#BridgeID
:BridgeID rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain <https://w3id.org/brot#Bridge> ;
          rdfs:range xsd:int ;
          rdfs:comment "Identifikationsnummer der Brücke"@de .


###  https://w3id.org/BCore#BridgeName
:BridgeName rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brot#Bridge> ;
            rdfs:range xsd:string ;
            rdfs:comment "Name der Brücke"@de .


###  https://w3id.org/BCore#BridgeStatus
:BridgeStatus rdf:type owl:DatatypeProperty ;
              rdfs:domain <https://w3id.org/brot#Bridge> ;
              rdfs:range xsd:string ;
              rdfs:comment "Status der Brücke"@de .


###  https://w3id.org/BCore#ComponentVolume
:ComponentVolume rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf owl:topDataProperty ;
                 rdf:type owl:FunctionalProperty ;
                 rdfs:domain <https://w3id.org/brot#Component> ;
                 rdfs:range xsd:decimal ;
                 rdfs:comment "Volumen"@de ,
                              "[m³]" .


###  https://w3id.org/BCore#Density
:Density rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf owl:topDataProperty ;
         rdf:type owl:FunctionalProperty ;
         rdfs:domain <https://w3id.org/bmat#BuildingMaterial> ;
         rdfs:range xsd:decimal ;
         rdfs:comment "Dichte"@de ,
                      "[kg/m³]" .


###  https://w3id.org/BCore#Ductility
:Ductility rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Steel ;
           rdfs:range xsd:string ;
           rdfs:comment "Duktilität"@de .


###  https://w3id.org/BCore#Ec
:Ec rdf:type owl:DatatypeProperty ,
             owl:FunctionalProperty ;
    rdfs:domain <https://w3id.org/bmat#Concrete> ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Elastizitätsmodul des Betons"@de ,
                 "[N/m²]" .


###  https://w3id.org/BCore#Ep
:Ep rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf owl:topDataProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain :PrestressingSteel ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Elastizitätsmodul des Spannstahls"@de ,
                 "[N/m²]" .


###  https://w3id.org/BCore#ExpositionClass
:ExpositionClass rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf owl:topDataProperty ;
                 rdfs:domain <https://w3id.org/bmat#Concrete> ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Expositionsklasse"@de ;
                 rdfs:seeAlso "https://w3id.org/bmat#expositionClassConcrete" .


###  https://w3id.org/BCore#Ey
:Ey rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf owl:topDataProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain :ConstructionSteel ,
                <https://w3id.org/bmat#ReinforcementSteel> ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Elastizitätsmodul des Stahls"@de ,
                 "[N/m²]" .


###  https://w3id.org/BCore#GirderShape
:GirderShape rdf:type owl:DatatypeProperty ;
             rdfs:domain <https://w3id.org/brcomp#Girder> ;
             rdfs:range xsd:string ;
             rdfs:comment "Form des Trägers"@de .


###  https://w3id.org/BCore#InfrastructureRouteName
:InfrastructureRouteName rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf owl:topDataProperty ;
                         rdfs:domain :InfrastructureRoute ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Name/ Bezeichnung der Infrastruktur"@de .


###  https://w3id.org/BCore#InfrastructureRouteWidth
:InfrastructureRouteWidth rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf owl:topDataProperty ;
                          rdf:type owl:FunctionalProperty ;
                          rdfs:domain :InfrastructureRoute ;
                          rdfs:range xsd:decimal ;
                          rdfs:comment "Querschnittsbreite der Infrastruktur"@de ,
                                       "[m]" .


###  https://w3id.org/BCore#Latitude
:Latitude rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdf:type owl:FunctionalProperty ;
          rdfs:domain :LocationPoint ;
          rdfs:range xsd:decimal ;
          rdfs:comment "Breitengrad"@de .


###  https://w3id.org/BCore#LocalX
:LocalX rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty ;
        rdf:type owl:FunctionalProperty ;
        rdfs:domain :LocationPoint ;
        rdfs:range xsd:decimal ;
        rdfs:comment "Lokale X-Koordinate"@de ,
                     "[m]" .


###  https://w3id.org/BCore#LocalY
:LocalY rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty ;
        rdf:type owl:FunctionalProperty ;
        rdfs:domain :LocationPoint ;
        rdfs:range xsd:decimal ;
        rdfs:comment "Lokale Y-Koordinate"@de ,
                     "[m]" .


###  https://w3id.org/BCore#LocalZ
:LocalZ rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty ;
        rdf:type owl:FunctionalProperty ;
        rdfs:domain :LocationPoint ;
        rdfs:range xsd:decimal ;
        rdfs:comment "Lokale Z-Koordinate"@de ,
                     "[m]" .


###  https://w3id.org/BCore#Longitude
:Longitude rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty ;
           rdf:type owl:FunctionalProperty ;
           rdfs:domain :LocationPoint ;
           rdfs:range xsd:decimal ;
           rdfs:comment "Längengrad"@de .


###  https://w3id.org/BCore#MaterialName
:MaterialName rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf owl:topDataProperty ;
              rdfs:domain <https://w3id.org/bmat#BuildingMaterial> ;
              rdfs:range xsd:string .


###  https://w3id.org/BCore#PylonShape
:PylonShape rdf:type owl:DatatypeProperty ;
            rdfs:domain <https://w3id.org/brcomp#Pylon> ;
            rdfs:range xsd:string ;
            rdfs:comment "Form des Pylonen"@de .


###  https://w3id.org/BCore#ZoneName
:ZoneName rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain <https://w3id.org/bot#Zone> ;
          rdfs:range xsd:string ;
          rdfs:comment "Name der Zone"@de .


###  https://w3id.org/BCore#fck
:fck rdf:type owl:DatatypeProperty ;
     rdfs:subPropertyOf owl:topDataProperty ;
     rdf:type owl:FunctionalProperty ;
     rdfs:domain <https://w3id.org/bmat#Concrete> ;
     rdfs:range xsd:decimal ;
     rdfs:comment "Charakteristische Druckfestigkeit des Betons"@de ,
                  "[N/m²]" .


###  https://w3id.org/BCore#fpk
:fpk rdf:type owl:DatatypeProperty ;
     rdfs:subPropertyOf owl:topDataProperty ;
     rdf:type owl:FunctionalProperty ;
     rdfs:domain :PrestressingSteel ;
     rdfs:range xsd:decimal ;
     rdfs:comment "Charakteristische Zugfestigkeit des Spannstahls"@de ,
                  "[N/m²]" .


###  https://w3id.org/BCore#fyk
:fyk rdf:type owl:DatatypeProperty ;
     rdfs:subPropertyOf owl:topDataProperty ;
     rdf:type owl:FunctionalProperty ;
     rdfs:domain :ConstructionSteel ,
                 <https://w3id.org/bmat#ReinforcementSteel> ;
     rdfs:range xsd:decimal ;
     rdfs:comment "Charakteristische Festigkeit des Stahls"@de ,
                  "[N/m²]" .


###  https://w3id.org/brcomp#height
<https://w3id.org/brcomp#height> rdf:type owl:DatatypeProperty ;
                                 rdfs:subPropertyOf owl:topDataProperty ;
                                 rdf:type owl:FunctionalProperty ;
                                 rdfs:domain <https://w3id.org/brot#Component> ;
                                 rdfs:range xsd:decimal ;
                                 rdfs:comment "Höhe"@de ,
                                              "[m]" .


###  https://w3id.org/brcomp#length
<https://w3id.org/brcomp#length> rdf:type owl:DatatypeProperty ;
                                 rdfs:subPropertyOf owl:topDataProperty ;
                                 rdf:type owl:FunctionalProperty ;
                                 rdfs:domain <https://w3id.org/brot#Component> ;
                                 rdfs:range xsd:decimal ;
                                 rdfs:comment "Länge"@de ,
                                              "[m]" .


###  https://w3id.org/brcomp#width
<https://w3id.org/brcomp#width> rdf:type owl:DatatypeProperty ;
                                rdfs:subPropertyOf owl:topDataProperty ;
                                rdf:type owl:FunctionalProperty ;
                                rdfs:domain <https://w3id.org/brot#Component> ;
                                rdfs:range xsd:decimal ;
                                rdfs:comment "Breite"@de ,
                                             "[m]" .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/BCore#Abutment
:Abutment rdf:type owl:Class ;
          rdfs:subClassOf <https://w3id.org/brcomp#SubStructureComponent> ;
          rdfs:comment "Widerlager"@de .


###  https://w3id.org/BCore#BoxGirder
:BoxGirder rdf:type owl:Class ;
           rdfs:subClassOf <https://w3id.org/brcomp#GirderMainGirder> ;
           rdfs:comment "Hohlkastenträger"@de .


###  https://w3id.org/BCore#City
:City rdf:type owl:Class ;
      rdfs:subClassOf <https://w3id.org/bot#Zone> ;
      rdfs:comment "Stadt"@de .


###  https://w3id.org/BCore#CompositeMaterial
:CompositeMaterial rdf:type owl:Class ;
                   rdfs:subClassOf <https://w3id.org/bmat#BuildingMaterial> ;
                   rdfs:comment "Materialverbund"@de .


###  https://w3id.org/BCore#ConstructionSteel
:ConstructionSteel rdf:type owl:Class ;
                   rdfs:subClassOf :Steel ;
                   rdfs:comment "Baustahl"@de .


###  https://w3id.org/BCore#Country
:Country rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/bot#Zone> ;
         rdfs:comment "Land"@de .


###  https://w3id.org/BCore#EquipmentComponent
:EquipmentComponent rdf:type owl:Class ;
                    rdfs:subClassOf <https://w3id.org/brot#Component> ;
                    owl:disjointWith <https://w3id.org/brcomp#SubStructureComponent> ,
                                     <https://w3id.org/brcomp#SuperStructureComponent> ;
                    rdfs:comment "Bauteil der Brückenausstattung"@de ;
                    rdfs:seeAlso "https://w3id.org/brcomp/#FinishingComponent" .


###  https://w3id.org/BCore#FootCycleRoute
:FootCycleRoute rdf:type owl:Class ;
                rdfs:subClassOf :InfrastructureRoute ;
                rdfs:comment "Geh- und/oder Radweg"@de .


###  https://w3id.org/BCore#IBeam
:IBeam rdf:type owl:Class ;
       rdfs:subClassOf <https://w3id.org/brcomp#GirderMainGirder> ;
       rdfs:comment "I-Träger"@de .


###  https://w3id.org/BCore#Image
:Image rdf:type owl:Class ;
       rdfs:subClassOf :MediaFile ;
       owl:disjointWith :TechnicalDocument ;
       rdfs:comment "Bild"@de .


###  https://w3id.org/BCore#InfrastructureRoute
:InfrastructureRoute rdf:type owl:Class ;
                     rdfs:comment "Infrastrukturtrasse"@de .


###  https://w3id.org/BCore#LocationPoint
:LocationPoint rdf:type owl:Class ;
               rdfs:comment "Örtlicher Punkt"@de .


