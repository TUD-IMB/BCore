@prefix : <https://w3id.org/bcore#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/bcore#> .

<https://w3id.org/bcore> rdf:type owl:Ontology ;
                          <http://purl.org/dc/elements/1.1/abstract> "The Bridge Core Ontology (BCore) enables the representation of a bridge structure, its components and material, as well as the infrastructure and media files connected to it and the environment and location of the bridge. BCore is created by the Institute of Concrete Structures (IMB) at the Dresden University of Technology (TUD)."@en ;
                          <http://purl.org/dc/elements/1.1/title> "Bridge Core Ontology for Institute of Concrete Structures, Dresden University of Technology"@en ;
                          <http://purl.org/dc/terms/contributor> "Jakob Vogt" ;
                          <http://purl.org/dc/terms/created> "2025-11-06"^^xsd:date ;
                          <http://purl.org/dc/terms/creator> "Johannes Reimer" ,
                                                             "Morris Florek" ,
                                                             "Tim Noack" ,
                                                             "Xiaoli Song" ;
                          <http://purl.org/dc/terms/description> "Core ontology for the representation of bridges."@en ;
                          <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/deed.en" ;
                          <http://purl.org/dc/terms/modified> "2026-07-21"^^xsd:date ;
                          <http://purl.org/ontology/bibo/status> "Ontology Specification Draft" ;
                          <http://purl.org/vocab/vann/preferredNamespacePrefix> "bcore" ;
                          rdfs:label "Bridge Core Ontology"@en ;
                          owl:versionInfo "0.1.0" ;
                          <https://schema.org/codeRepository> "https://github.com/TUD-IMB/BCore" .
                          <http://xmlns.com/foaf/0.1/logo> "https://raw.githubusercontent.com/TUD-IMB/BCore/main/BCore.svg" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/abstract
<http://purl.org/dc/elements/1.1/abstract> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/ontology/bibo/status
<http://purl.org/ontology/bibo/status> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionIRI
owl:versionIRI rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/logo
<http://xmlns.com/foaf/0.1/logo> rdf:type owl:AnnotationProperty .


###  https://schema.org/codeRepository
<https://schema.org/codeRepository> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/bcore#bridgesRoute
:bridgesRoute rdf:type owl:ObjectProperty ;
              rdfs:domain <https://w3id.org/brot#Bridge> ;
              rdfs:range :InfrastructureRoute ;
              rdfs:comment "Brücke überquert Trasse"@de ,
                           "bridge bridges route"@en .


###  https://w3id.org/bcore#bridgesZone
:bridgesZone rdf:type owl:ObjectProperty ;
             rdfs:domain <https://w3id.org/brot#Bridge> ;
             rdfs:range <https://w3id.org/bot#Zone> ;
             rdfs:comment "Brücke überquert Zone"@de ,
                          "bridge bridges zone"@en .


###  https://w3id.org/bcore#carriesRoute
:carriesRoute rdf:type owl:ObjectProperty ;
              owl:inverseOf :traversesBridge ;
              rdfs:domain <https://w3id.org/brot#Bridge> ;
              rdfs:range :InfrastructureRoute ;
              rdfs:comment "Brücke überführt Trasse"@de ,
                           "bridge carries route"@en .


###  https://w3id.org/bcore#crossesRoute
:crossesRoute rdf:type owl:ObjectProperty ,
                       owl:SymmetricProperty ;
              rdfs:domain :InfrastructureRoute ;
              rdfs:range :InfrastructureRoute ;
              rdfs:comment "Trasse kreuzt Trasse"@de ,
                           "route crosses route"@en .


###  https://w3id.org/bcore#crossesZone
:crossesZone rdf:type owl:ObjectProperty ;
             rdfs:domain :InfrastructureRoute ;
             rdfs:range <https://w3id.org/bot#Zone> ;
             rdfs:comment "Trasse durchquert Zone"@de ,
                          "route crosses zone"@en .


###  https://w3id.org/bcore#describes
:describes rdf:type owl:ObjectProperty ;
           rdfs:domain :MediaFile ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( <https://w3id.org/brot#Bridge>
                                      <https://w3id.org/brot#Component>
                                    )
                      ] ;
           rdfs:comment "Mediendatei beschreibt (stellt dar, zeigt, veranschaulicht) eine Brücke"@de ,
                        "media file describes (represents, depicts, illustrates) a bridge"@en .


###  https://w3id.org/bcore#hasPartialStructure
:hasPartialStructure rdf:type owl:ObjectProperty ;
                     owl:inverseOf :isPartialStructureOf ;
                     rdfs:domain <https://w3id.org/brot#Bridge> ;
                     rdfs:range <https://w3id.org/brot#Bridge> ;
                     rdfs:comment "Brücke besitzt Brückenzug"@de ,
                                  "bridge contains partial structure (bridge section)"@en .


###  https://w3id.org/bcore#includesPoint
:includesPoint rdf:type owl:ObjectProperty ;
               owl:inverseOf :isPartOfRoute ;
               rdfs:domain :InfrastructureRoute ;
               rdfs:range <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation> ;
               rdfs:comment "Trasse enthält Lokalisation (Trassenpunkt)"@de ,
                            "route contains localisation (route point)"@en .


###  https://w3id.org/bcore#liesWithin
:liesWithin rdf:type owl:ObjectProperty ;
            owl:inverseOf <https://w3id.org/bot#containsZone> ;
            rdf:type owl:TransitiveProperty ;
            rdfs:domain <https://w3id.org/bot#Zone> ;
            rdfs:range <https://w3id.org/bot#Zone> ;
            rdfs:comment "Zone liegt in Zone"@de ,
                         "zone lies within zone"@en .


###  https://w3id.org/bcore#isLocatedAt
:isLocatedAt rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain <https://w3id.org/bot#Zone> ;
           rdfs:range <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation> ;
           rdfs:comment "Zone befindet sich an Lokalisierung (Ort)"@de ,
                        "zone is located at localisation (location)"@en .


###  https://w3id.org/bcore#isLocatedInZone
:isLocatedInZone rdf:type owl:ObjectProperty ;
               rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point> ;
               rdfs:range <https://w3id.org/bot#Zone> ;
               rdfs:comment "Lokalisierung (Ort) befindet sich in Zone"@de ,
                            "localisation (location) is located in zone"@en .


###  https://w3id.org/bcore#locationAt
:locationAt rdf:type owl:ObjectProperty ;
            rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation> ;
            rdfs:range <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point> ;
            rdfs:comment "Punkt der Lokalisierung (Ort)"@de ,
                         "point of the line localisation (location)"@en ;
            rdfs:seeAlso "https://dtc-ontology.cms.ed.tum.de/infraspatialot#isisLocatedAt" .


###  https://w3id.org/bcore#locationEndsAt
:locationEndsAt rdf:type owl:ObjectProperty ;
                rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#LineLocalisation> ;
                rdfs:range <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point> ;
                owl:propertyDisjointWith :locationStartsAt ;
                rdfs:comment "Endpunkt der Linienlokalisierung"@de ,
                             "end point of the line localisation"@en .


###  https://w3id.org/bcore#locationStartsAt
:locationStartsAt rdf:type owl:ObjectProperty ;
                  rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#LineLocalisation> ;
                  rdfs:range <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point> ;
                  rdfs:comment "Startpunkt der Linienlokalisierung"@de ,
                               "starting point of the line localisation"@en .


###  https://w3id.org/bcore#isMadeOfMaterial
:isMadeOfMaterial rdf:type owl:ObjectProperty ;
                rdfs:domain <https://w3id.org/brot#Component> ;
                rdfs:range <https://w3id.org/bmat#BuildingMaterial> ;
                rdfs:comment "Bauteil besteht aus Material"@de ,
                             "component consists of material"@en .


###  https://w3id.org/bcore#isPartOfComponent
:isPartOfComponent rdf:type owl:ObjectProperty ;
                 owl:inverseOf <https://w3id.org/brot#aggregates> ;
                 rdf:type owl:TransitiveProperty ;
                 rdfs:domain <https://w3id.org/brot#Component> ;
                 rdfs:range <https://w3id.org/brot#Component> ;
                 rdfs:comment "Bauteil ist Teil von Bauteil"@de ,
                              "component is part of component"@en .


###  https://w3id.org/bcore#isPartOfRoute
:isPartOfRoute rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation> ;
             rdfs:range :InfrastructureRoute ;
             rdfs:comment "Trassenpunkt ist Teil von Trasse"@de ,
                          "route point is part of a route"@en .


###  https://w3id.org/bcore#isPartOfZone
:isPartOfZone rdf:type owl:ObjectProperty ;
            owl:inverseOf <https://w3id.org/brot#containsComponent> ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brot#Component> ;
            rdfs:range <https://w3id.org/brot#SpatialZone> ;
            rdfs:comment "Bauteil ist Teil genau einer Zone (z.B. Brücke)"@de ,
                         "component is part of exactly one zone (e.g., bridge)"@en .


###  https://w3id.org/bcore#isPartialStructureOf
:isPartialStructureOf rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain <https://w3id.org/brot#Bridge> ;
                    rdfs:range <https://w3id.org/brot#Bridge> ;
                    rdfs:comment "Brückenzug ist Teil genau einer Brücke"@de ,
                                 "bridge section is part of exactly one bridge"@en .


###  https://w3id.org/bcore#traversesBridge
:traversesBridge rdf:type owl:ObjectProperty ;
                 rdfs:domain :InfrastructureRoute ;
                 rdfs:range <https://w3id.org/brot#Bridge> ;
                 rdfs:comment "Trasse überquert/führt über Brücke"@de ,
                              "route crosses/goes over bridge"@en .


###  https://w3id.org/bot#containsZone
<https://w3id.org/bot#containsZone> rdf:type owl:ObjectProperty ,
                                             owl:TransitiveProperty ;
                                    rdfs:domain <https://w3id.org/bot#Zone> ;
                                    rdfs:range <https://w3id.org/bot#Zone> ;
                                    rdfs:comment "Zone enthält Zone"@de ,
                                                 "zone contains zone"@en .


###  https://w3id.org/bot#intersectsZone
<https://w3id.org/bot#intersectsZone> rdf:type owl:ObjectProperty ,
                                               owl:SymmetricProperty ;
                                      rdfs:domain <https://w3id.org/bot#Zone> ;
                                      rdfs:range <https://w3id.org/bot#Zone> ;
                                      rdfs:comment "Zone schneidet Zone"@de ,
                                                   "zone intersects zone"@en .


###  https://w3id.org/brot#aggregates
<https://w3id.org/brot#aggregates> rdf:type owl:ObjectProperty ,
                                            owl:TransitiveProperty ;
                                   rdfs:domain <https://w3id.org/brot#Component> ;
                                   rdfs:range <https://w3id.org/brot#Component> ;
                                   rdfs:comment "Bauteil besteht aus Bauteil"@de ,
                                                "component consists of component"@en .


###  https://w3id.org/brot#containsComponent
<https://w3id.org/brot#containsComponent> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <https://w3id.org/brot#SpatialZone> ;
                                          rdfs:range <https://w3id.org/brot#Component> ;
                                          rdfs:comment "Brücke besteht aus Bauteil"@de ,
                                                       "bridge consists of component"@en .


###  https://w3id.org/reloc#meetBottom
<https://w3id.org/reloc#meetBottom> rdf:type owl:ObjectProperty ;
                                    owl:inverseOf <https://w3id.org/reloc#meetTop> ;
                                    rdfs:domain <https://w3id.org/brot#Component> ;
                                    rdfs:range <https://w3id.org/brot#Component> ;
                                    rdfs:comment "Bauteil liegt direkt unter anderem Bauteil"@de ,
                                                 "component is located directly below another component"@en .


###  https://w3id.org/reloc#meetFront
<https://w3id.org/reloc#meetFront> rdf:type owl:ObjectProperty ;
                                   owl:inverseOf <https://w3id.org/reloc#meetRear> ;
                                   rdfs:domain <https://w3id.org/brot#Component> ;
                                   rdfs:range <https://w3id.org/brot#Component> ;
                                   rdfs:comment "Bauteil liegt direkt vor anderem Bauteil"@de ,
                                                "component is located directly in front of another component"@en .


###  https://w3id.org/reloc#meetLeft
<https://w3id.org/reloc#meetLeft> rdf:type owl:ObjectProperty ;
                                  owl:inverseOf <https://w3id.org/reloc#meetRight> ;
                                  rdfs:domain <https://w3id.org/brot#Component> ;
                                  rdfs:range <https://w3id.org/brot#Component> ;
                                  rdfs:comment "Bauteil liegt links angrenzend zu anderem Bauteil"@de ,
                                               "component is located directly to the left of another component"@en .


###  https://w3id.org/reloc#meetRear
<https://w3id.org/reloc#meetRear> rdf:type owl:ObjectProperty ;
                                  rdfs:domain <https://w3id.org/brot#Component> ;
                                  rdfs:range <https://w3id.org/brot#Component> ;
                                  rdfs:comment "Bauteil liegt direkt hinter anderem Bauteil"@de ,
                                               "component is located directly behind another component"@en .


###  https://w3id.org/reloc#meetRight
<https://w3id.org/reloc#meetRight> rdf:type owl:ObjectProperty ;
                                   rdfs:domain <https://w3id.org/brot#Component> ;
                                   rdfs:range <https://w3id.org/brot#Component> ;
                                   rdfs:comment "Bauteil liegt rechts angrenzend zu anderem Bauteil"@de ,
                                                "component is located directly to the right of another component"@en .


###  https://w3id.org/reloc#meetTop
<https://w3id.org/reloc#meetTop> rdf:type owl:ObjectProperty ;
                                 rdfs:domain <https://w3id.org/brot#Component> ;
                                 rdfs:range <https://w3id.org/brot#Component> ;
                                 rdfs:comment "Bauteil liegt direkt über anderem Bauteil"@de ,
                                              "component is located directly above another component"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/bcore#Altitude
:Altitude rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point> ;
          rdfs:range xsd:decimal ;
          rdfs:comment "Höhe ü. NN (bezogen auf das lokal gültige amtliche Höhensystem)"@de ,
                       "elevation above sea level (according to the locally applicable official elevation system)"@en ,
                       "[m]" .


###  https://w3id.org/bcore#BridgeConstructionEndDate
:BridgeConstructionEndDate rdf:type owl:DatatypeProperty ,
                                    owl:FunctionalProperty ;
                           rdfs:domain <https://w3id.org/brot#Bridge> ;
                           rdfs:range xsd:date ;
                           rdfs:comment "Enddatum des Baus der Brücke (Fertigstellung)"@de ,
                                        "end date of the bridge's construction (completion)"@en ,
                                        "[ISO Date Format]" .


###  https://w3id.org/bcore#BridgeConstructionStart
:BridgeConstructionStart rdf:type owl:DatatypeProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain <https://w3id.org/brot#Bridge> ;
                         rdfs:range xsd:date ;
                         rdfs:comment "Startdatum des Baus der Brücke"@de ,
                                      "start date of the bridge's construction"@en ,
                                      "[ISO Date Format]" .


###  https://w3id.org/bcore#BridgeID
:BridgeID rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain <https://w3id.org/brot#Bridge> ;
          rdfs:range xsd:int ;
          rdfs:comment "Identifikationsnummer der Brücke"@de ,
                       "bridge identification number"@en .


###  https://w3id.org/bcore#BridgeLength
:BridgeLength rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain <https://w3id.org/brot#Bridge> ;
              rdfs:range xsd:decimal ;
              rdfs:comment "Länge der Brücke"@de ,
                           "length of the bridge"@en ,
                           "[m]" .


###  https://w3id.org/bcore#BridgeLoadCase
:BridgeLoadCase rdf:type owl:DatatypeProperty ;
                rdfs:domain <https://w3id.org/brot#Bridge> ;
                rdfs:range xsd:string ;
                rdfs:comment "maximaler Lastfall, für den die Brücke bemessen wurde (z.B. \"LM1\" oder \"BK30/60\" in Deutschland)"@de ,
                             "maximum load case the bridge is designed for (e.g., \"LM1\" or \"BK30/60\" in Germany)"@en .


###  https://w3id.org/bcore#BridgeName
:BridgeName rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain <https://w3id.org/brot#Bridge> ;
            rdfs:range xsd:string ;
            rdfs:comment "Name der Brücke"@de ,
                         "name of the bridge"@en .


###  https://w3id.org/bcore#BridgePlanningEnd
:BridgePlanningEnd rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain <https://w3id.org/brot#Bridge> ;
                   rdfs:range xsd:date ;
                   rdfs:comment "Enddatum der Planungsphase der Brücke"@de ,
                                "end date of the bridge's planning phase"@en ,
                                "[ISO Date Format]" .


###  https://w3id.org/bcore#BridgePlanningStart
:BridgePlanningStart rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain <https://w3id.org/brot#Bridge> ;
                     rdfs:range xsd:date ;
                     rdfs:comment "Startdatum der Planungsphase der Brücke"@de ,
                                  "start date of the bridge's planning phase"@en ,
                                  "[ISO Date Format]" .


###  https://w3id.org/bcore#BridgeStatus
:BridgeStatus rdf:type owl:DatatypeProperty ;
              rdfs:domain <https://w3id.org/brot#Bridge> ;
              rdfs:range xsd:string ;
              rdfs:comment "Status der Brücke"@de ,
                           "status of the bridge"@en .


###  https://w3id.org/bcore#CountryISOCode
:CountryISOCode rdf:type owl:DatatypeProperty ;
                rdfs:domain :Country ;
                rdfs:range xsd:string ;
                rdfs:comment "Ländercode nach ISO-3166-1 (ALPHA-2)"@de ,
                             "country code according to ISO 3166-1 (ALPHA-2)"@en .


###  https://w3id.org/bcore#Density
:Density rdf:type owl:DatatypeProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain <https://w3id.org/bmat#BuildingMaterial> ;
         rdfs:range xsd:decimal ;
         rdfs:comment "Dichte"@de ,
                      "density"@en ,
                      "[kg/m³]" .


###  https://w3id.org/bcore#InfrastructureRouteClearanceHeight
:InfrastructureRouteClearanceHeight rdf:type owl:DatatypeProperty ,
                                             owl:FunctionalProperty ;
                                    rdfs:domain :InfrastructureRoute ;
                                    rdfs:range xsd:decimal ;
                                    rdfs:comment "Höhe des Lichtraumprofils der Trasse"@de ,
                                                 "height of the route's clearance profile"@en ,
                                                 "[m]" .


###  https://w3id.org/bcore#InfrastructureRouteName
:InfrastructureRouteName rdf:type owl:DatatypeProperty ;
                         rdfs:domain :InfrastructureRoute ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Name oder Bezeichnung der Infrastrukturtrasse"@de ,
                                      "name or designation of the infrastructure route"@en .


###  https://w3id.org/bcore#InfrastructureRouteWidth
:InfrastructureRouteWidth rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :InfrastructureRoute ;
                          rdfs:range xsd:decimal ;
                          rdfs:comment "Querschnittsbreite der Infrastrukturtrasse"@de ,
                                       "[m]" ,
                                       "cross-sectional width of the infrastructure route" .


###  https://w3id.org/bcore#Latitude
:Latitude rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point> ;
          rdfs:range xsd:decimal ;
          rdfs:comment "Breitengrad"@de ,
                       "latitude"@en .


###  https://w3id.org/bcore#LocalX
:LocalX rdf:type owl:DatatypeProperty ,
                 owl:FunctionalProperty ;
        rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point> ;
        rdfs:range xsd:decimal ;
        rdfs:comment "local X-coordinate"@en ,
                     "lokale X-Koordinate"@de ,
                     "[m]" .


###  https://w3id.org/bcore#LocalY
:LocalY rdf:type owl:DatatypeProperty ,
                 owl:FunctionalProperty ;
        rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point> ;
        rdfs:range xsd:decimal ;
        rdfs:comment "local Y-coordinate"@en ,
                     "lokale Y-Koordinate"@de ,
                     "[m]" .


###  https://w3id.org/bcore#LocalZ
:LocalZ rdf:type owl:DatatypeProperty ,
                 owl:FunctionalProperty ;
        rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point> ;
        rdfs:range xsd:decimal ;
        rdfs:comment "local Z-coordinate"@en ,
                     "lokale Z-Koordinate"@de ,
                     "[m]" .


###  https://w3id.org/bcore#LocalisationName
:LocalisationName rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation> ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Name der Lokalisierung (Standort)"@de ,
                               "name of the localisation (location)"@en .


###  https://w3id.org/bcore#LocalisationStation
:LocalisationStation rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation> ;
                     rdfs:range xsd:decimal ;
                     rdfs:comment "Kilometrierung der Lokalisierung (des Standortes) auf der Trasse"@de ,
                                  "kilometer marking of the localisation (location) on the route"@en ,
                                  "[km]" .


###  https://w3id.org/bcore#Longitude
:Longitude rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain <https://dtc-ontology.cms.ed.tum.de/infraspatialot#Point> ;
           rdfs:range xsd:decimal ;
