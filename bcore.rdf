        <rdfs:comment xml:lang="en">component is located directly to the right of another component</rdfs:comment>
        <rdfs:label xml:lang="de">liegt rechts von</rdfs:label>
        <rdfs:label xml:lang="en">meet right</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/reloc#meetTop -->

    <owl:ObjectProperty rdf:about="https://w3id.org/reloc#meetTop">
