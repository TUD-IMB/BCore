     -->

    


    <!-- https://w3id.org/bcore/infra#FootCycleRoute -->

    <owl:Class rdf:about="https://w3id.org/bcore/infra#FootCycleRoute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:comment xml:lang="de">Geh- und/oder Radweg</rdfs:comment>
        <rdfs:comment xml:lang="en">footpath and/or bike path</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/infra#RailwayRoute -->

    <owl:Class rdf:about="https://w3id.org/bcore/infra#RailwayRoute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:comment xml:lang="de">Schienenweg</rdfs:comment>
        <rdfs:comment xml:lang="en">railway</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/infra#RoadRoute -->

    <owl:Class rdf:about="https://w3id.org/bcore/infra#RoadRoute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:comment xml:lang="de">Straße</rdfs:comment>
        <rdfs:comment xml:lang="en">road/street</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/infra#WaterWayRoute -->

    <owl:Class rdf:about="https://w3id.org/bcore/infra#WaterWayRoute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:comment xml:lang="de">Wasserstraße</rdfs:comment>
        <rdfs:comment xml:lang="en">water way</rdfs:comment>
    </owl:Class>
    


