            <rdf:Description rdf:about="https://w3id.org/bcore/infra#FootCycleRoute"/>
            <rdf:Description rdf:about="https://w3id.org/bcore/infra#RailwayRoute"/>
            <rdf:Description rdf:about="https://w3id.org/bcore/infra#RoadRoute"/>
            <rdf:Description rdf:about="https://w3id.org/bcore/infra#WaterWayRoute"/>
        </owl:members>
    </rdf:Description>
</rdf:RDF>



