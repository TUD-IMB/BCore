    <!-- https://w3id.org/bcore/infra#FootCycleRouteType -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/infra#FootCycleRouteType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/infra#FootCycleRoute"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>bike only</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>foot only</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>segregated</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>shared-use</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="de">Art des Fuß- und/oder Radweges</rdfs:comment>
        <rdfs:comment xml:lang="en">Possible values:
- foot only
- bike only
- segregated
- shared-use</rdfs:comment>
        <rdfs:comment xml:lang="en">type of pedestrian and/or bike path</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/infra#RailwayRouteMaximumVelocity -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/infra#RailwayRouteMaximumVelocity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/infra#RailwayRoute"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>[km/h]</rdfs:comment>
        <rdfs:comment xml:lang="de">maximal zulässige Geschwindigkeit auf dem Schienenweg</rdfs:comment>
        <rdfs:comment xml:lang="en">maximum permitted speed on the rail line</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/infra#RailwayRouteNumberOfTracks -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/infra#RailwayRouteNumberOfTracks">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/infra#RailwayRoute"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="de">Anzahl der Gleise des Schienenweges</rdfs:comment>
        <rdfs:comment xml:lang="en">number of tracks on the railroad</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/infra#RoadRouteClass -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/infra#RoadRouteClass">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/infra#RoadRoute"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>country road</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>district road</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>federal road</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>highway</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>non-public road</rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first>urban road</rdf:first>
                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="de">Straßenklasse</rdfs:comment>
        <rdfs:comment xml:lang="en">possible values:
- highway
- federal road
- country road
- district road
- urban road
- non-public road</rdfs:comment>
        <rdfs:comment xml:lang="en">road classification</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/infra#RoadRouteNumberOfLanes -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/infra#RoadRouteNumberOfLanes">
        <rdfs:domain rdf:resource="https://w3id.org/bcore/infra#RoadRoute"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="de">Anzahl der Fahrstreifen der Straße (Gesamtzahl beider Richtungsfahrbahnen)</rdfs:comment>
        <rdfs:comment xml:lang="en">number of lanes on the road (total number of lanes in both directions)</rdfs:comment>
    </owl:DatatypeProperty>
    


