        <rdfs:comment xml:lang="de">Baustahl</rdfs:comment>
        <rdfs:comment xml:lang="en">construction steel</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/mat#Metal -->

    <owl:Class rdf:about="https://w3id.org/bcore/mat#Metal">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bmat#BuildingMaterial"/>
        <rdfs:comment xml:lang="de">Metall</rdfs:comment>
        <rdfs:comment xml:lang="en">metal</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/mat#PrestressedConcrete -->

    <owl:Class rdf:about="https://w3id.org/bcore/mat#PrestressedConcrete">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/mat#CompositeMaterial"/>
        <rdfs:comment xml:lang="de">Spannbeton</rdfs:comment>
        <rdfs:comment xml:lang="en">prestressed concrete</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/mat#PrestressingSteel -->

    <owl:Class rdf:about="https://w3id.org/bcore/mat#PrestressingSteel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/mat#Steel"/>
        <rdfs:comment xml:lang="de">Spannstahl</rdfs:comment>
        <rdfs:comment xml:lang="en">prestressing steel</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/mat#Steel -->

    <owl:Class rdf:about="https://w3id.org/bcore/mat#Steel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/mat#Metal"/>
        <rdfs:comment xml:lang="de">Stahl</rdfs:comment>
        <rdfs:comment xml:lang="en">steel</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/mat#SteelConcreteComposite -->

    <owl:Class rdf:about="https://w3id.org/bcore/mat#SteelConcreteComposite">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/mat#CompositeMaterial"/>
        <rdfs:comment xml:lang="de">Stahl-Beton-Verbund</rdfs:comment>
        <rdfs:comment xml:lang="en">steel-concrete composite</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bmat#Concrete -->

    <owl:Class rdf:about="https://w3id.org/bmat#Concrete">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bmat#BuildingMaterial"/>
        <rdfs:comment xml:lang="de">Beton</rdfs:comment>
        <rdfs:comment xml:lang="en">concrete</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bmat#ReinforcedConcrete -->

    <owl:Class rdf:about="https://w3id.org/bmat#ReinforcedConcrete">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/mat#CompositeMaterial"/>
        <rdfs:comment xml:lang="de">Stahlbeton</rdfs:comment>
        <rdfs:comment xml:lang="en">reinforced concrete</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/bmat#ReinforcementSteel -->

    <owl:Class rdf:about="https://w3id.org/bmat#ReinforcementSteel">
