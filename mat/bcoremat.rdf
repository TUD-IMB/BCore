    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/bcore/mat#Ductility -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/mat#Ductility">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/mat#Steel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="de">die Eigenschaft eines Werkstoffes, sich unter Zugbelastung vor einem Bruch dauerhaft plastisch zu verformen (https://de.wikipedia.org/wiki/Duktilit%C3%A4t)</rdfs:comment>
        <rdfs:comment xml:lang="en">the ability of a material to sustain significant plastic deformation before fracture when undergoing tension (https://en.wikipedia.org/wiki/Ductility)</rdfs:comment>
        <rdfs:label xml:lang="de">Duktilität</rdfs:label>
        <rdfs:label xml:lang="en">ductility</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/mat#Ec -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/mat#Ec">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bmat#Concrete"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Elastizitätsmodul des Betons</rdfs:comment>
        <rdfs:comment xml:lang="en">modulus of elasticity (Young&apos;s modulus) of the concrete</rdfs:comment>
        <rdfs:label xml:lang="de">Ec</rdfs:label>
        <rdfs:label xml:lang="en">Ec</rdfs:label>
        <schema:unitText>N/m²</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/mat#Ep -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/mat#Ep">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/mat#PrestressingSteel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Elastizitätsmodul des Spannstahls</rdfs:comment>
        <rdfs:comment xml:lang="en">modulus of elasticity (Young&apos;s modulus) of the prestressing steel</rdfs:comment>
        <rdfs:label xml:lang="de">Ep</rdfs:label>
        <rdfs:label xml:lang="en">Ep</rdfs:label>
        <schema:unitText>N/m²</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/mat#ExpositionClass -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/mat#ExpositionClass">
        <rdfs:domain rdf:resource="https://w3id.org/bmat#Concrete"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="de">Expositionsklasse (z. B. nach Eurocode 2-1-1)</rdfs:comment>
        <rdfs:comment xml:lang="en">exposure class (e.g., according to Eurocode 2-1-1)</rdfs:comment>
        <rdfs:label xml:lang="de">Expositionsklasse</rdfs:label>
        <rdfs:label xml:lang="en">exposition class</rdfs:label>
        <rdfs:seeAlso>https://w3id.org/bmat#expositionClassConcrete</rdfs:seeAlso>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/mat#Ey -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/mat#Ey">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/bcore/mat#ConstructionSteel"/>
                    <rdf:Description rdf:about="https://w3id.org/bmat#ReinforcementSteel"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Elastizitätsmodul des Stahls</rdfs:comment>
        <rdfs:comment xml:lang="en">modulus of elasticity (Young&apos;s modulus) of the steel</rdfs:comment>
        <rdfs:label xml:lang="de">Ey</rdfs:label>
        <rdfs:label xml:lang="en">Ey</rdfs:label>
        <schema:unitText>N/m²</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/mat#fck -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/mat#fck">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bmat#Concrete"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">characteristic compressive strength of the concrete</rdfs:comment>
        <rdfs:comment xml:lang="de">charakteristische Druckfestigkeit des Betons</rdfs:comment>
        <rdfs:label xml:lang="de">fck</rdfs:label>
        <rdfs:label xml:lang="en">fck</rdfs:label>
        <schema:unitText>N/m²</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/mat#fpk -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/mat#fpk">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore/mat#PrestressingSteel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>N/m²</rdfs:comment>
        <rdfs:comment xml:lang="en">characteristic tensile strength of the prestressing steel</rdfs:comment>
        <rdfs:comment xml:lang="de">charakteristische Zugfestigkeit des Spannstahls</rdfs:comment>
        <rdfs:label xml:lang="de">fpk</rdfs:label>
        <rdfs:label xml:lang="en">fpk</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore/mat#fyk -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore/mat#fyk">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/bcore/mat#ConstructionSteel"/>
                    <rdf:Description rdf:about="https://w3id.org/bmat#ReinforcementSteel"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">characteristic tensile strength of the steel</rdfs:comment>
        <rdfs:comment xml:lang="de">charakteristische Zugfestigkeit des Stahls</rdfs:comment>
        <rdfs:label xml:lang="de">fyk</rdfs:label>
        <rdfs:label xml:lang="en">fyk</rdfs:label>
        <schema:unitText>N/m²</schema:unitText>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/bcore/mat#CompositeMaterial -->

    <owl:Class rdf:about="https://w3id.org/bcore/mat#CompositeMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bmat#BuildingMaterial"/>
        <rdfs:comment xml:lang="de">Verbundstoff/ Material, das sich heterogen aus mehreren anderen Materialien zusammensetzt</rdfs:comment>
        <rdfs:comment xml:lang="en">material, that is heterogenically composed of several materials</rdfs:comment>
        <rdfs:label xml:lang="de">Verbundmaterial</rdfs:label>
        <rdfs:label xml:lang="en">composite material</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/mat#ConstructionSteel -->

    <owl:Class rdf:about="https://w3id.org/bcore/mat#ConstructionSteel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/mat#Steel"/>
        <rdfs:comment xml:lang="en">Stahl für den Stahl- und den Maschinenbau</rdfs:comment>
        <rdfs:comment xml:lang="en">structural steel, used for making construction elements in a variety of shapes</rdfs:comment>
        <rdfs:label xml:lang="de">Baustahl</rdfs:label>
        <rdfs:label xml:lang="en">construction steel</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/mat#Metal -->

    <owl:Class rdf:about="https://w3id.org/bcore/mat#Metal">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bmat#BuildingMaterial"/>
        <rdfs:comment xml:lang="en">elemental metal, metallic construction material or alloy</rdfs:comment>
        <rdfs:comment xml:lang="de">elementares Metall, metallischer Werkstoff oder Legierung</rdfs:comment>
        <rdfs:label xml:lang="de">Metall</rdfs:label>
        <rdfs:label xml:lang="en">metal</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/mat#PrestressedConcrete -->

    <owl:Class rdf:about="https://w3id.org/bcore/mat#PrestressedConcrete">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/mat#CompositeMaterial"/>
        <rdfs:comment xml:lang="de">Beton, der mit vorgespannten Spanngliedern aus anderen Materialien (Stahl, Carbon, ...) durchsetzt ist</rdfs:comment>
        <rdfs:comment xml:lang="en">concrete that is permeated by prestressed tendons of other material (steel, carbon fibers, ...)</rdfs:comment>
        <rdfs:label xml:lang="de">Spannbeton</rdfs:label>
        <rdfs:label xml:lang="en">prestressed concrete</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/mat#PrestressingSteel -->

    <owl:Class rdf:about="https://w3id.org/bcore/mat#PrestressingSteel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/mat#Steel"/>
        <rdfs:comment xml:lang="en">high-tensile steel that is mostly used in prestressed concrete structures</rdfs:comment>
        <rdfs:comment xml:lang="de">hochfester Stahl, der vor allem im Spannbetonbau zum Vorspannen verwendet wird (https://de.wikipedia.org/wiki/Spannstahl)</rdfs:comment>
        <rdfs:label xml:lang="de">Spannstahl</rdfs:label>
        <rdfs:label xml:lang="en">prestressing steel</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/mat#Steel -->

    <owl:Class rdf:about="https://w3id.org/bcore/mat#Steel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/mat#Metal"/>
        <rdfs:comment xml:lang="de">Werkstoff, der überwiegend aus Eisen mit geringem Kohlenstoffanteil besteht (de.wikipedia.org/wiki/Stahl)</rdfs:comment>
        <rdfs:comment xml:lang="en">alloy of iron and carbon (en.wikipedia.org/wiki/Steel)</rdfs:comment>
        <rdfs:label xml:lang="de">Stahl</rdfs:label>
        <rdfs:label xml:lang="en">steel</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bcore/mat#SteelConcreteComposite -->

    <owl:Class rdf:about="https://w3id.org/bcore/mat#SteelConcreteComposite">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/mat#CompositeMaterial"/>
        <rdfs:comment xml:lang="de">Verbund aus (bewehrtem) Beton und Baustahl, die aber räumlich bis auf eine Verbundfläche getrennt sind</rdfs:comment>
        <rdfs:comment xml:lang="en">composite of (reinforced) concrete and construction steel, that are spatially separated</rdfs:comment>
        <rdfs:label xml:lang="de">Stahl-Beton-Verbund</rdfs:label>
        <rdfs:label xml:lang="en">steel-concrete composite</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bmat#BuildingMaterial -->

    <owl:Class rdf:about="https://w3id.org/bmat#BuildingMaterial"/>
    


    <!-- https://w3id.org/bmat#Concrete -->

    <owl:Class rdf:about="https://w3id.org/bmat#Concrete">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bmat#BuildingMaterial"/>
        <rdfs:comment xml:lang="de">Baustoff, der als Dispersion unter Zugabe von Flüssigkeit aus einem Bindemittel und Zuschlagstoffen angemischt wird (de.wikipedia.org/wiki/Beton)</rdfs:comment>
        <rdfs:comment xml:lang="en">composite material composed of aggregate bound together with a fluid cement that cures to a solid (en.wikipedia.org/wiki/Concrete)</rdfs:comment>
        <rdfs:label xml:lang="de">Beton</rdfs:label>
        <rdfs:label xml:lang="en">concrete</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bmat#ReinforcedConcrete -->

    <owl:Class rdf:about="https://w3id.org/bmat#ReinforcedConcrete">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/mat#CompositeMaterial"/>
        <rdfs:comment xml:lang="de">Beton, der von schlaffer Stahlbewehrung durchsetzt ist</rdfs:comment>
        <rdfs:comment xml:lang="en">concrete that is permeated by steel reinforcement</rdfs:comment>
        <rdfs:label xml:lang="de">Stahlbeton</rdfs:label>
        <rdfs:label xml:lang="en">reinforced concrete</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bmat#ReinforcementSteel -->

    <owl:Class rdf:about="https://w3id.org/bmat#ReinforcementSteel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bcore/mat#Steel"/>
        <rdfs:comment xml:lang="de">Bewehrungsstahl, für schlaffe Bewehrungen von Stahlbeton verwendet</rdfs:comment>
        <rdfs:comment xml:lang="en">reinforcement (mild) steel</rdfs:comment>
        <rdfs:label xml:lang="de">Betonstahl</rdfs:label>
        <rdfs:label xml:lang="en">reinforcement steel</rdfs:label>
    </owl:Class>
    


