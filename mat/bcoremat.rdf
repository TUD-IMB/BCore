    <!-- https://w3id.org/bcore/mat#isCompositeOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bcore/mat#isCompositeOf">
        <rdfs:domain rdf:resource="https://w3id.org/bcore/mat#CompositeMaterial"/>
        <rdfs:range rdf:resource="https://w3id.org/bmat#BuildingMaterial"/>
        <rdfs:comment xml:lang="de">Verbundmaterial ist Verbund aus anderem Material</rdfs:comment>
        <rdfs:comment xml:lang="en">composite material is a composite of another material</rdfs:comment>
        <rdfs:label xml:lang="en">is composite of</rdfs:label>
        <rdfs:label xml:lang="de">ist Verbund aus</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
