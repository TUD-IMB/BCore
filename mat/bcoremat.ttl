#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/bcore/mat#compositeOf
:compositeOf rdf:type owl:ObjectProperty ;
             rdfs:domain :CompositeMaterial ;
             rdfs:range <https://w3id.org/bmat#BuildingMaterial> ;
             rdfs:comment "Verbundmaterial ist Verbund aus anderem Material"@de ,
                          "composite material is a composite of another material"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/bcore/mat#Ductility
:Ductility rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Steel ;
           rdfs:range xsd:string ;
           rdfs:comment "Duktilität"@de ,
                        "ductility"@en .


###  https://w3id.org/bcore/mat#Ec
:Ec rdf:type owl:DatatypeProperty ,
             owl:FunctionalProperty ;
    rdfs:domain <https://w3id.org/bmat#Concrete> ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Elastizitätsmodul des Betons"@de ,
                 "modulus of elasticity (Young's modulus) of the concrete"@en ,
                 "[N/m²]" .


###  https://w3id.org/bcore/mat#Ep
:Ep rdf:type owl:DatatypeProperty ,
             owl:FunctionalProperty ;
    rdfs:domain :PrestressingSteel ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Elastizitätsmodul des Spannstahls"@de ,
                 "modulus of elasticity (Young's modulus) of the prestressing steel"@en ,
                 "[N/m²]" .


###  https://w3id.org/bcore/mat#ExpositionClass
:ExpositionClass rdf:type owl:DatatypeProperty ;
                 rdfs:domain <https://w3id.org/bmat#Concrete> ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Expositionsklasse (z. B. nach Eurocode 2-1-1)"@de ,
                              "exposure class (e.g., according to Eurocode 2-1-1)"@en ;
                 rdfs:seeAlso "https://w3id.org/bmat#expositionClassConcrete" .


###  https://w3id.org/bcore/mat#Ey
:Ey rdf:type owl:DatatypeProperty ,
             owl:FunctionalProperty ;
    rdfs:domain :ConstructionSteel ,
                <https://w3id.org/bmat#ReinforcementSteel> ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Elastizitätsmodul des Stahls"@de ,
                 "modulus of elasticity (Young's modulus) of the steel"@en ,
                 "[N/m²]" .


###  https://w3id.org/bcore/mat#fck
:fck rdf:type owl:DatatypeProperty ,
              owl:FunctionalProperty ;
     rdfs:domain <https://w3id.org/bmat#Concrete> ;
     rdfs:range xsd:decimal ;
     rdfs:comment "characteristic compressive strength of the concrete"@en ,
                  "charakteristische Druckfestigkeit des Betons"@de ,
                  "[N/m²]" .


###  https://w3id.org/bcore/mat#fpk
:fpk rdf:type owl:DatatypeProperty ,
              owl:FunctionalProperty ;
     rdfs:domain :PrestressingSteel ;
     rdfs:range xsd:decimal ;
     rdfs:comment "characteristic tensile strength of the prestressing steel"@en ,
                  "charakteristische Zugfestigkeit des Spannstahls"@de ,
                  "[N/m²]" .


###  https://w3id.org/bcore/mat#fyk
:fyk rdf:type owl:DatatypeProperty ,
              owl:FunctionalProperty ;
     rdfs:domain :ConstructionSteel ,
                 <https://w3id.org/bmat#ReinforcementSteel> ;
     rdfs:range xsd:decimal ;
     rdfs:comment "characteristic tensile strength of the steel"@en ,
                  "charakteristische Zugfestigkeit des Stahls"@de ,
                  "[N/m²]" .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/bcore/mat#CompositeMaterial
:CompositeMaterial rdf:type owl:Class ;
                   rdfs:subClassOf <https://w3id.org/bmat#BuildingMaterial> ;
                   rdfs:comment "Verbundmaterial"@de ,
                                "composite material"@en .


###  https://w3id.org/bcore/mat#ConstructionSteel
:ConstructionSteel rdf:type owl:Class ;
                   rdfs:subClassOf :Steel ;
                   rdfs:comment "Baustahl"@de ,
                                "construction steel"@en .


###  https://w3id.org/bcore/mat#Metal
:Metal rdf:type owl:Class ;
       rdfs:subClassOf <https://w3id.org/bmat#BuildingMaterial> ;
       rdfs:comment "Metall"@de ,
                    "metal"@en .


###  https://w3id.org/bcore/mat#PrestressedConcrete
:PrestressedConcrete rdf:type owl:Class ;
                     rdfs:subClassOf :CompositeMaterial ;
                     rdfs:comment "Spannbeton"@de ,
                                  "prestressed concrete"@en .


###  https://w3id.org/bcore/mat#PrestressingSteel
:PrestressingSteel rdf:type owl:Class ;
                   rdfs:subClassOf :Steel ;
                   rdfs:comment "Spannstahl"@de ,
                                "prestressing steel"@en .


###  https://w3id.org/bcore/mat#Steel
:Steel rdf:type owl:Class ;
       rdfs:subClassOf :Metal ;
       rdfs:comment "Stahl"@de ,
                    "steel"@en .


###  https://w3id.org/bcore/mat#SteelConcreteComposite
:SteelConcreteComposite rdf:type owl:Class ;
                        rdfs:subClassOf :CompositeMaterial ;
                        rdfs:comment "Stahl-Beton-Verbund"@de ,
                                     "steel-concrete composite"@en .


###  https://w3id.org/bmat#BuildingMaterial
<https://w3id.org/bmat#BuildingMaterial> rdf:type owl:Class .


###  https://w3id.org/bmat#Concrete
<https://w3id.org/bmat#Concrete> rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/bmat#BuildingMaterial> ;
                                 rdfs:comment "Beton"@de ,
                                              "concrete"@en .


###  https://w3id.org/bmat#ReinforcedConcrete
<https://w3id.org/bmat#ReinforcedConcrete> rdf:type owl:Class ;
                                           rdfs:subClassOf :CompositeMaterial ;
                                           rdfs:comment "Stahlbeton"@de ,
                                                        "reinforced concrete"@en .


###  https://w3id.org/bmat#ReinforcementSteel
<https://w3id.org/bmat#ReinforcementSteel> rdf:type owl:Class ;
                                           rdfs:subClassOf :Steel ;
                                           rdfs:comment "Betonstahl"@de ,
                                                        "reinforcement (mild) steel"@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :CompositeMaterial
                :Metal
                <https://w3id.org/bmat#Concrete>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :PrestressedConcrete
                :SteelConcreteComposite
                <https://w3id.org/bmat#ReinforcedConcrete>
              )
] .


