<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/bcore#"
     xml:base="https://w3id.org/bcore"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:dct="https://w3id.org/bcore#dct:"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="https://w3id.org/bcore#vann:"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/bcore">
        <dc:abstract xml:lang="en">The Bridge Core Ontology (BCore) enables the represetation of a bridge structure, its components and material, as well as the infrastructure and media files connected to it and the environment and location of the bridge. BCore is created by the Institute of Concrete Structures (IMB) at the Dresden University of Technology (TUD).</dc:abstract>
        <dc:title xml:lang="en">Bridge Core Ontology for Institute of Concrete Structures, Dresden University of Technology</dc:title>
        <terms:contributor>Jakob Vogt</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-06</terms:created>
        <terms:creator>Johannes Reimer</terms:creator>
        <terms:creator>Morris Florek</terms:creator>
        <terms:creator>Tim Noack</terms:creator>
        <terms:creator>Xiaoli Song</terms:creator>
        <rdfs:label xml:lang="en">Bridge Core Ontology</rdfs:label>
        <owl:versionInfo>0.0.1</owl:versionInfo>
        <dct:description xml:lang="en">Core ontology for the representation of bridges.</dct:description>
        <vann:preferredNamespacePrefix>bcore</vann:preferredNamespacePrefix>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/abstract -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/abstract"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/contributor -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://www.w3.org/2002/07/owl#versionIRI -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionIRI"/>
    


    <!-- https://w3id.org/bcore#dct:description -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/bcore#dct:description"/>
    


    <!-- https://w3id.org/bcore#vann:preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/bcore#vann:preferredNamespacePrefix"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/bcore#bridgesRoute -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#bridgesRoute">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:comment xml:lang="de">Brücke überquert Trasse</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#bridgesZone -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#bridgesZone">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Brücke überquert Zone</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#carriesRoute -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#carriesRoute">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/bcore#traversesBridge"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:comment xml:lang="de">Brücke folgt Trasse</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#compositeOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#compositeOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#CompositeMaterial"/>
        <rdfs:range rdf:resource="https://w3id.org/bmat#BuildingMaterial"/>
        <rdfs:comment xml:lang="de">Verbundmaterial ist Verbund aus anderem Material</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#crossesRoute -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#crossesRoute">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:comment xml:lang="de">Trasse kreuzt Trasse</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#crossesZone -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#crossesZone">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:range rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Trasse durchquert Zone</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#describes -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#describes">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#MediaFile"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:comment xml:lang="de">Medium stellt Brücke dar</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#hasPartialStructure -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#hasPartialStructure">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/bcore#partialStructureOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:comment xml:lang="de">Brücke besitzt Brückenzug</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#includesPoint -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#includesPoint">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/bcore#partOfRoute"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore#RoutePoint"/>
        <rdfs:comment xml:lang="de">Trasse enthält Trassenpunkt</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#liesWithin -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#liesWithin">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/bot#containsZone"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:range rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Zone liegt in Zone</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#locatedAt -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#locatedAt">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore#LocationPoint"/>
        <rdfs:comment xml:lang="de">Zone befindet sich an Ort</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#locatedInZone -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#locatedInZone">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#LocationPoint"/>
        <rdfs:range rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Örtlicher Punkt befindet sich in Zone</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#madeOfMaterial -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#madeOfMaterial">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/bmat#BuildingMaterial"/>
        <rdfs:comment xml:lang="de">Bauteil besteht aus Material</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#partOfComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#partOfComponent">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/brot#aggregates"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Bauteil ist Teil von Bauteil</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#partOfRoute -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#partOfRoute">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#RoutePoint"/>
        <rdfs:range rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:comment xml:lang="de">Trassenpunkt ist Teil von Trasse</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#partOfZone -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#partOfZone">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/brot#containsComponent"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#SpatialZone"/>
        <rdfs:comment xml:lang="de">Bauteil ist Teil genau einer Brücke</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#partialStructureOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#partialStructureOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:comment xml:lang="de">Brückenzug ist Teil genau einer Brücke</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bcore#traversesBridge -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bcore#traversesBridge">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#InfrastructureRoute"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:comment xml:lang="de">Trasse überquert Brücke</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bot#containsZone -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bot#containsZone">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:range rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Zone enthält Zone</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bot#intersectsZone -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bot#intersectsZone">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:range rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:comment xml:lang="de">Zone schneidet Zone</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brot#aggregates -->


    <owl:ObjectProperty rdf:about="https://w3id.org/brot#aggregates">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Bauteil besteht aus Bauteil</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brot#containsComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/brot#containsComponent">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#SpatialZone"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Brücke besteht aus Bauteil</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/reloc#meetBottom -->


    <owl:ObjectProperty rdf:about="https://w3id.org/reloc#meetBottom">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/reloc#meetTop"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Bauteil liegt direkt unter anderem Bauteil</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/reloc#meetLeft -->


    <owl:ObjectProperty rdf:about="https://w3id.org/reloc#meetLeft">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/reloc#meetRight"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Bauteil liegt links angrenzend zu anderem Bauteil</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/reloc#meetRight -->


    <owl:ObjectProperty rdf:about="https://w3id.org/reloc#meetRight">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Bauteil liegt rechts angrenzend zu anderem Bauteil</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/reloc#meetTop -->


    <owl:ObjectProperty rdf:about="https://w3id.org/reloc#meetTop">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:comment xml:lang="de">Bauteil liegt direkt über anderem Bauteil</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/bcore#Altitude -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#Altitude">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#LocationPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Höhe über NN</rdfs:comment>
        <rdfs:comment>[m]</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore#ArchShape -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#ArchShape">
        <rdfs:domain rdf:resource="https://w3id.org/brcomp#Arch"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Form des Bogens</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore#BridgeConstructionEndDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#BridgeConstructionEndDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="de">Datum der Brückenfertigstellung</rdfs:comment>
        <rdfs:comment>[ISO Date Format]</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore#BridgeID -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#BridgeID">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="de">Identifikationsnummer der Brücke</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore#BridgeName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#BridgeName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="de">Name der Brücke</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore#BridgeStatus -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#BridgeStatus">
        <rdfs:domain rdf:resource="https://w3id.org/brot#Bridge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="de">Status der Brücke</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore#ComponentVolume -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#ComponentVolume">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brot#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Volumen</rdfs:comment>
        <rdfs:comment>[m³]</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore#Density -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#Density">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bmat#BuildingMaterial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Dichte</rdfs:comment>
        <rdfs:comment>[kg/m³]</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore#Ductility -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#Ductility">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bcore#Steel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="de">Duktilität</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bcore#Ec -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/bcore#Ec">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bmat#Concrete"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="de">Elastizitätsmodul des Betons</rdfs:comment>
        <rdfs:comment>[N/m²]</rdfs:comment>
    </owl:DatatypeProperty>
    


